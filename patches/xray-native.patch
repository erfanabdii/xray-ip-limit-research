+func TestValidationMissingInitialPolicyHasNoNativeLimit(t *testing.T) {
+	state := newPolicyState(map[string]struct{}{"alice": {}}, filepath.Join(t.TempDir(), "missing.json"))
+	if err := state.initialize(); err == nil {

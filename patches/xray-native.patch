+	}
+	manager := newStatsManager(t)
+	for _, ip := range []string{"192.0.2.1", "192.0.2.2"} {
+		ctx, cancel := inboundContext("alice", ip)
+		defer cancel()
+		got, err := gateWithState(ctx, manager, state)
+		if err != nil || got != ctx || Reserved(got, "alice", ip) {
+			t.Fatalf("cold-start reproduction changed: IP=%s got=%v err=%v", ip, got, err)
+		}
+	}
+	t.Log("CONFIRMED GAP: missing initial policy leaves both distinct fixture IPs unrestricted until a valid policy is loaded")
+}

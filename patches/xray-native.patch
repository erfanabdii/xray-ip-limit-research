+
+	appstats "github.com/xtls/xray-core/app/stats"
+	commonnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	featurestats "github.com/xtls/xray-core/features/stats"
+)
+
+func TestGateScopeAndAccountIsolation(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1, "other": 1})
+	manager := newStatsManager(t)
+
+	testContext, cancelTest := inboundContext("alice", "192.0.2.1")
+	defer cancelTest()
+	reserved, err := gateWithState(testContext, manager, state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !Reserved(reserved, "alice", "192.0.2.1") {
+		t.Fatal("scoped user did not receive a reservation marker")
+	}
+
+	secondContext, cancelSecond := inboundContext("alice", "192.0.2.2")
+	defer cancelSecond()
+	if _, err := gateWithState(secondContext, manager, state); err == nil {
+		t.Fatal("second IP was admitted above the limit")
+	}
+
+	otherContext, cancelOther := inboundContext("other", "192.0.2.2")
+	defer cancelOther()
+	otherReserved, err := gateWithState(otherContext, manager, state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !Reserved(otherReserved, "other", "192.0.2.2") {
+		t.Fatal("second account did not receive its own reservation")
+	}
+	assertOnlineCount(t, manager, "user>>>alice>>>online", 1)
+	assertOnlineCount(t, manager, "user>>>other>>>online", 1)
+}
+
+func TestGateNestedReservationAndRelease(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager := newStatsManager(t)
+	ctx, cancel := inboundContext("alice", "192.0.2.3")
+	defer cancel()
+
+	reserved, err := gateWithState(ctx, manager, state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nested := session.SubContextFromMuxInbound(reserved)
+	if _, err := gateWithState(nested, manager, state); err != nil {
+		t.Fatal(err)
+	}
+	if !Reserved(nested, "alice", "192.0.2.3") {
+		t.Fatal("nested mux context did not inherit the reservation")
+	}
+	assertOnlineCount(t, manager, "user>>>alice>>>online", 1)
+
+	cancel()
+	waitOnlineCount(t, manager, "user>>>alice>>>online", 0)
+}
+
+func TestGateRequiresSourceAndReservationSupportOnlyForLimitedUser(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager := newStatsManager(t)
+
+	invalidSource := session.ContextWithInbound(context.Background(), &session.Inbound{
+		User: &protocol.MemoryUser{Email: "alice"},
+	})
+	if _, err := gateWithState(invalidSource, manager, state); err == nil {
+		t.Fatal("limited user with no source address was accepted")
+	}
+
+	localhost, cancelLocalhost := inboundContext("alice", "127.0.0.1")
+	defer cancelLocalhost()
+	if _, err := gateWithState(localhost, manager, state); err == nil {
+		t.Fatal("localhost source was accepted")
+	}
+
+	ordinary, cancelOrdinary := inboundContext("unmanaged", "not-an-ip")
+	defer cancelOrdinary()
+	if returned, err := gateWithState(ordinary, manager, state); err != nil || returned != ordinary {
+		t.Fatalf("unmanaged account should follow stock path: ctx=%v err=%v", returned, err)
+	}
+
+	valid, cancelValid := inboundContext("alice", "192.0.2.4")
+	defer cancelValid()
+	if _, err := gateWithState(valid, nil, state); err == nil {
+		t.Fatal("limited user was accepted without a stats manager")
+	}
+	if _, err := gateWithState(valid, featurestats.NoopManager{}, state); err == nil {
+		t.Fatal("limited user was accepted without an online map")
+	}
+	if _, err := gateWithState(valid, unsupportedOnlineMapManager{}, state); err == nil {
+		t.Fatal("online map without TryAddIP was accepted")
+	}
+}
+
+func TestPolicyReloadZeroAndMalformedRetainsPrevious(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "policy.json")
+	state := newPolicyState(map[string]struct{}{"alice": {}}, path)
+	writePolicy(t, path, map[string]int{"alice": 1})
+	if err := state.applyFile(); err != nil {
+		t.Fatal(err)
+	}
+
+	manager := newStatsManager(t)
+	first, cancelFirst := inboundContext("alice", "192.0.2.5")
+	defer cancelFirst()
+	if _, err := gateWithState(first, manager, state); err != nil {
+		t.Fatal(err)
+	}
+
+	writePolicy(t, path, map[string]int{"alice": -1})
+	if err := state.applyFile(); err == nil {
+		t.Fatal("negative limit was accepted")
+	}
+	second, cancelSecond := inboundContext("alice", "192.0.2.6")
+	defer cancelSecond()
+	if _, err := gateWithState(second, manager, state); err == nil {
+		t.Fatal("malformed update replaced the previous positive limit")
+	}
+
+	writePolicy(t, path, map[string]int{"alice": 0})
+	if err := state.applyFile(); err != nil {
+		t.Fatal(err)
+	}
+	third, cancelThird := inboundContext("alice", "192.0.2.6")
+	defer cancelThird()
+	returned, err := gateWithState(third, manager, state)
+	if err != nil || returned != third || Reserved(returned, "alice", "192.0.2.6") {
+		t.Fatalf("zero limit should disable reservation: ctx=%v err=%v", returned, err)
+	}
+	assertOnlineCount(t, manager, "user>>>alice>>>online", 1)
+}
+
+func TestPolicyRejectsUnknownScopeAndOversizedInput(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "policy.json")
+	state := newPolicyState(map[string]struct{}{"alice": {}}, path)
+	if err := os.WriteFile(path, []byte(`{"version":2,"users":{"alice":1}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := state.applyFile(); err == nil {
+		t.Fatal("unsupported policy version was accepted")
+	}
+
+	writePolicy(t, path, map[string]int{"other": 1})
+	if err := state.applyFile(); err == nil {
+		t.Fatal("policy user outside allowlist was accepted")
+	}
+
+	if err := os.WriteFile(path, make([]byte, maxPolicyBytes+1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := state.applyFile(); err == nil {
+		t.Fatal("oversized policy file was accepted")
+	}
+}
+
+func stateWithCaps(t *testing.T, caps map[string]int) *policyState {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "policy.json")
+	allowlist := make(map[string]struct{}, len(caps))
+	for email := range caps {
+		allowlist[email] = struct{}{}
+	}
+	state := newPolicyState(allowlist, path)
+	writePolicy(t, path, caps)
+	if err := state.applyFile(); err != nil {
+		t.Fatal(err)
+	}
+	return state
+}
+
+func writePolicy(t *testing.T, path string, users map[string]int) {
+	t.Helper()
+	data, err := json.Marshal(policyDocument{Version: 1, Users: users})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func newStatsManager(t *testing.T) *appstats.Manager {
+	t.Helper()
+	manager, err := appstats.NewManager(context.Background(), &appstats.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return manager
+}
+
+func inboundContext(email, source string) (context.Context, context.CancelFunc) {
+	ctx, cancel := context.WithCancel(context.Background())
+	return session.ContextWithInbound(ctx, &session.Inbound{
+		User:   &protocol.MemoryUser{Email: email},
+		Source: commonnet.Destination{Address: commonnet.ParseAddress(source)},
+	}), cancel
+}
+
+func assertOnlineCount(t *testing.T, manager *appstats.Manager, name string, want int) {
+	t.Helper()
+	onlineMap := manager.GetOnlineMap(name)
+	if onlineMap == nil {
+		if want == 0 {
+			return
+		}
+		t.Fatalf("online map %q was not created", name)
+	}
+	if got := onlineMap.Count(); got != want {
+		t.Fatalf("online map %q count = %d, want %d", name, got, want)
+	}
+}
+
+func waitOnlineCount(t *testing.T, manager *appstats.Manager, name string, want int) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		onlineMap := manager.GetOnlineMap(name)
+		if onlineMap == nil && want == 0 {
+			return
+		}
+		if onlineMap != nil && onlineMap.Count() == want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	assertOnlineCount(t, manager, name, want)
+}
+
+type unsupportedOnlineMapManager struct {
+	featurestats.NoopManager
+}
+
+func (unsupportedOnlineMapManager) GetOrRegisterOnlineMap(string) (featurestats.OnlineMap, error) {
+	return unsupportedOnlineMap{}, nil
+}
+
+type unsupportedOnlineMap struct{}
+
+func (unsupportedOnlineMap) Count() int                       { return 0 }
+func (unsupportedOnlineMap) AddIP(string)                     {}
+func (unsupportedOnlineMap) RemoveIP(string)                  {}
+func (unsupportedOnlineMap) ForEach(func(string, int64) bool) {}
diff --git a/common/nativeiplimit/nativeiplimit_benchmark_test.go b/common/nativeiplimit/nativeiplimit_benchmark_test.go
new file mode 100644
--- /dev/null
+++ b/common/nativeiplimit/nativeiplimit_benchmark_test.go
@@ -0,0 +1,194 @@
+package nativeiplimit
+
+import (
+	"context"
+	"runtime"
+	"testing"
+	"time"
+
+	appstats "github.com/xtls/xray-core/app/stats"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+)
+
+const (
+	benchmarkOnlineMapName = "user>>>alice>>>online"
+	knownIPCleanupBatch    = 256
+)
+
+type benchmarkOnlineCounter interface {
+	Count() int
+}
+
+func benchmarkContext(email, ip string) (context.Context, context.CancelFunc) {
+	base, cancel := context.WithCancel(context.Background())
+	return session.ContextWithInbound(base, &session.Inbound{
+		User:   &protocol.MemoryUser{Email: email},
+		Source: net.Destination{Address: net.ParseAddress(ip)},
+	}), cancel
+}
+
+func benchmarkPolicy() *policyState {
+	state := newPolicyState(map[string]struct{}{"alice": {}}, "")
+	state.snapshot.Store(&policySnapshot{users: map[string]int{"alice": 1}})
+	return state
+}
+
+func benchmarkManager(b *testing.B) *appstats.Manager {
+	b.Helper()
+	manager, err := appstats.NewManager(context.Background(), &appstats.Config{})
+	if err != nil {
+		b.Fatal(err)
+	}
+	return manager
+}
+
+func benchmarkOnlineMap(b *testing.B, manager *appstats.Manager) benchmarkOnlineCounter {
+	b.Helper()
+	onlineMap := manager.GetOnlineMap(benchmarkOnlineMapName)
+	if onlineMap == nil {
+		b.Fatal("benchmark online map was not registered")
+	}
+	return onlineMap
+}
+
+func reserveBenchmarkAnchor(b *testing.B, manager *appstats.Manager, state *policyState, ip string) (context.Context, context.CancelFunc, benchmarkOnlineCounter) {
+	b.Helper()
+	ctx, cancel := benchmarkContext("alice", ip)
+	reserved, err := gateWithState(ctx, manager, state)
+	if err != nil {
+		cancel()
+		b.Fatal(err)
+	}
+	if !Reserved(reserved, "alice", ip) {
+		cancel()
+		b.Fatal("benchmark anchor did not reserve its source IP")
+	}
+	return reserved, cancel, benchmarkOnlineMap(b, manager)
+}
+
+func cleanupBenchmarkAnchor(b *testing.B, cancel context.CancelFunc, onlineMap benchmarkOnlineCounter) {
+	b.Helper()
+	cancel()
+	waitBenchmarkOnlineCount(b, onlineMap, 0)
+}
+
+func waitBenchmarkOnlineCount(b *testing.B, onlineMap benchmarkOnlineCounter, want int) {
+	b.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if got := onlineMap.Count(); got == want {
+			return
+		}
+		runtime.Gosched()
+		time.Sleep(100 * time.Microsecond)
+	}
+	b.Fatalf("online IP count did not return to %d; got %d", want, onlineMap.Count())
+}
+
+func BenchmarkGate(b *testing.B) {
+	b.Run("unmanaged_email_fastpath", func(b *testing.B) {
+		state := benchmarkPolicy()
+		ctx, cancel := benchmarkContext("control", "192.0.2.1")
+		defer func() {
+			b.StopTimer()
+			cancel()
+		}()
+
+		b.ReportAllocs()
+		b.ResetTimer()
+		for i := 0; i < b.N; i++ {
+			got, err := gateWithState(ctx, nil, state)
+			if err != nil || got != ctx {
+				b.Fatalf("unmanaged fast path returned ctx=%p err=%v", got, err)
+			}
+		}
+	})
+
+	b.Run("already_reserved_nested_context", func(b *testing.B) {
+		state := benchmarkPolicy()
+		manager := benchmarkManager(b)
+		reservedAnchor, cancel, onlineMap := reserveBenchmarkAnchor(b, manager, state, "192.0.2.10")
+		nested := context.WithValue(reservedAnchor, struct{ name string }{"nested"}, true)
+		defer func() {
+			b.StopTimer()
+			cleanupBenchmarkAnchor(b, cancel, onlineMap)
+		}()
+
+		b.ReportAllocs()
+		b.ResetTimer()
+		for i := 0; i < b.N; i++ {
+			got, err := gateWithState(nested, nil, state)
+			if err != nil || got != nested {
+				b.Fatalf("nested reservation returned ctx=%p err=%v", got, err)
+			}
+		}
+	})
+
+	b.Run("rejected_second_ip_at_cap_1", func(b *testing.B) {
+		state := benchmarkPolicy()
+		manager := benchmarkManager(b)
+		_, cancelAnchor, onlineMap := reserveBenchmarkAnchor(b, manager, state, "192.0.2.20")
+		second, cancelSecond := benchmarkContext("alice", "192.0.2.21")
+		defer func() {
+			b.StopTimer()
+			cancelSecond()
+			cleanupBenchmarkAnchor(b, cancelAnchor, onlineMap)
+		}()
+
+		b.ReportAllocs()
+		b.ResetTimer()
+		for i := 0; i < b.N; i++ {
+			if _, err := gateWithState(second, manager, state); err == nil {
+				b.Fatal("second IP was admitted at cap 1")
+			}
+		}
+	})
+
+	b.Run("admitted_known_ip_fresh_context_cleanup_batch_256", func(b *testing.B) {
+		state := benchmarkPolicy()
+		manager := benchmarkManager(b)
+		b.ReportAllocs()
+		b.ResetTimer()
+
+		completed := 0
+		for completed < b.N {
+			batch := min(knownIPCleanupBatch, b.N-completed)
+			b.StopTimer()
+			_, cancelAnchor, onlineMap := reserveBenchmarkAnchor(b, manager, state, "192.0.2.30")
+			contexts := make([]context.Context, batch)
+			cancels := make([]context.CancelFunc, batch)
+			for i := range contexts {
+				contexts[i], cancels[i] = benchmarkContext("alice", "192.0.2.30")
+			}
+
+			var gateErr error
+			var lastReserved context.Context
+			b.StartTimer()
+			for _, ctx := range contexts {
+				reserved, err := gateWithState(ctx, manager, state)
+				if err != nil {
+					gateErr = err
+					break
+				}
+				lastReserved = reserved
+			}
+			b.StopTimer()
+			markerMissing := gateErr == nil && !Reserved(lastReserved, "alice", "192.0.2.30")
+			for _, cancel := range cancels {
+				cancel()
+			}
+			cleanupBenchmarkAnchor(b, cancelAnchor, onlineMap)
+			if gateErr != nil {
+				b.Fatal(gateErr)
+			}
+			if markerMissing {
+				b.Fatal("admitted known IP did not carry its reservation marker")
+			}
+			completed += batch
+			b.StartTimer()
+		}
+		b.StopTimer()
+	})
+}
diff --git a/common/nativeiplimit/validation_pass2_test.go b/common/nativeiplimit/validation_pass2_test.go
new file mode 100644
--- /dev/null
+++ b/common/nativeiplimit/validation_pass2_test.go
@@ -0,0 +1,362 @@
+package nativeiplimit
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	appstats "github.com/xtls/xray-core/app/stats"
+	featurestats "github.com/xtls/xray-core/features/stats"
+)
+
+const validationOnlineMapName = "user>>>alice>>>online"
+
+func TestValidationCapOneConcurrentDifferentIPsHasExactlyOneWinner(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager := newStatsManager(t)
+
+	const contenders = 128
+	type result struct {
+		ip  string
+		ctx context.Context
+		err error
+	}
+	start := make(chan struct{})
+	results := make(chan result, contenders)
+	cancels := make([]context.CancelFunc, contenders)
+	for i := 0; i < contenders; i++ {
+		ip := fmt.Sprintf("198.51.100.%d", i+1)
+		ctx, cancel := inboundContext("alice", ip)
+		cancels[i] = cancel
+		go func(ip string, ctx context.Context) {
+			<-start
+			reserved, err := gateWithState(ctx, manager, state)
+			results <- result{ip: ip, ctx: reserved, err: err}
+		}(ip, ctx)
+	}
+	close(start)
+
+	winners := 0
+	var winnerIP string
+	for i := 0; i < contenders; i++ {
+		got := <-results
+		if got.err == nil {
+			winners++
+			winnerIP = got.ip
+			if !Reserved(got.ctx, "alice", got.ip) {
+				t.Errorf("winner %q has no matching reservation marker", got.ip)
+			}
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("simultaneous admissions accepted %d unique IPs, want exactly 1", winners)
+	}
+	assertOnlineCount(t, manager, validationOnlineMapName, 1)
+
+	for _, cancel := range cancels {
+		cancel()
+	}
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+	if winnerIP == "" {
+		t.Fatal("the winning IP was not recorded")
+	}
+}
+
+func TestValidationSameIPRootContextsReleaseOnlyAfterLastCancel(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager, countedManager, countedMap := newRemovalCountingManager(t)
+
+	const reservations = 96
+	const ip = "192.0.2.80"
+	cancels := make([]context.CancelFunc, reservations)
+	for i := range cancels {
+		ctx, cancel := inboundContext("alice", ip)
+		cancels[i] = cancel
+		reserved, err := gateWithState(ctx, countedManager, state)
+		if err != nil {
+			t.Fatalf("root context %d for the already admitted IP was rejected: %v", i, err)
+		}
+		if !Reserved(reserved, "alice", ip) {
+			t.Fatalf("root context %d has no reservation marker", i)
+		}
+	}
+	assertOnlineCount(t, manager, validationOnlineMapName, 1)
+
+	for _, cancel := range cancels[:reservations-1] {
+		cancel()
+	}
+	waitRemovalCount(t, countedMap, reservations-1)
+	if got := manager.GetOnlineMap(validationOnlineMapName).Count(); got != 1 {
+		t.Fatalf("unique-IP count after canceling %d of %d roots = %d, want 1", reservations-1, reservations, got)
+	}
+	if got := countedMap.removals.Load(); got != reservations-1 {
+		t.Fatalf("release callbacks before last cancel = %d, want %d", got, reservations-1)
+	}
+
+	cancels[reservations-1]()
+	waitRemovalCount(t, countedMap, reservations)
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+	if got := countedMap.removals.Load(); got != reservations {
+		t.Fatalf("total release callbacks = %d, want %d", got, reservations)
+	}
+}
+
+func TestValidationAlternatingIPReservationChurnLeavesNoRetainedState(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 2})
+	manager, countedManager, countedMap := newRemovalCountingManager(t)
+
+	const batchSize = 64
+	const churnBatches = 256
+	const churnReservations = batchSize * churnBatches
+	const warmupReservations = batchSize
+
+	runAlternatingReservationBatches(t, manager, countedManager, countedMap, state, 1, batchSize, 0)
+	waitRemovalCount(t, countedMap, warmupReservations)
+	settleValidationRuntime()
+
+	var before runtime.MemStats
+	runtime.ReadMemStats(&before)
+	beforeGoroutines := runtime.NumGoroutine()
+
+	runAlternatingReservationBatches(t, manager, countedManager, countedMap, state, churnBatches, batchSize, warmupReservations)
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+	waitRemovalCount(t, countedMap, warmupReservations+churnReservations)
+	settleValidationRuntime()
+
+	var after runtime.MemStats
+	runtime.ReadMemStats(&after)
+	afterGoroutines := runtime.NumGoroutine()
+	heapDelta := int64(after.HeapAlloc) - int64(before.HeapAlloc)
+	allocDelta := after.TotalAlloc - before.TotalAlloc
+	goroutineDelta := afterGoroutines - beforeGoroutines
+	t.Logf("churn reservations=%d batches=%d batch_size=%d; HeapAlloc before=%d after=%d delta=%d bytes; TotalAlloc before=%d after=%d delta=%d bytes; goroutines before=%d after=%d delta=%d",
+		churnReservations, churnBatches, batchSize,
+		before.HeapAlloc, after.HeapAlloc, heapDelta,
+		before.TotalAlloc, after.TotalAlloc, allocDelta,
+		beforeGoroutines, afterGoroutines, goroutineDelta)
+
+	if allocDelta == 0 {
+		t.Fatal("TotalAlloc did not change during reservation churn; allocation evidence is unavailable")
+	}
+	const retainedHeapAllowance = 8 << 20
+	if heapDelta > retainedHeapAllowance {
+		t.Fatalf("post-GC retained heap grew by %d bytes, above the %d-byte allowance", heapDelta, retainedHeapAllowance)
+	}
+	const goroutineAllowance = 16
+	if goroutineDelta > goroutineAllowance {
+		t.Fatalf("goroutine count grew by %d, above the %d-goroutine allowance", goroutineDelta, goroutineAllowance)
+	}
+}
+
+func TestValidationAdmissionOnAlreadyCancelledContextReleasesReservation(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager := newStatsManager(t)
+	ctx, cancel := inboundContext("alice", "192.0.2.81")
+	cancel()
+
+	reserved, err := gateWithState(ctx, manager, state)
+	if err != nil {
+		t.Fatalf("already-cancelled context admission returned an error: %v", err)
+	}
+	if !Reserved(reserved, "alice", "192.0.2.81") {
+		t.Fatal("already-cancelled context did not receive its admission marker")
+	}
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+}
+
+func TestValidationDeadlineContextReleasesReservation(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager := newStatsManager(t)
+	parent, cancelParent := inboundContext("alice", "192.0.2.82")
+	defer cancelParent()
+	ctx, cancelDeadline := context.WithTimeout(parent, 100*time.Millisecond)
+	defer cancelDeadline()
+
+	if _, err := gateWithState(ctx, manager, state); err != nil {
+		t.Fatal(err)
+	}
+	<-ctx.Done()
+	if !errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		t.Fatalf("deadline context ended with %v, want DeadlineExceeded", ctx.Err())
+	}
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+}
+
+func TestValidationAncestorCancellationReleasesReservation(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager := newStatsManager(t)
+	parent, cancelParent := inboundContext("alice", "192.0.2.83")
+	child, cancelChild := context.WithCancel(parent)
+	defer cancelChild()
+
+	if _, err := gateWithState(child, manager, state); err != nil {
+		t.Fatal(err)
+	}
+	cancelParent()
+	<-child.Done()
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+}
+
+func TestValidationNestedReservationMarkerReleasesExactlyOnce(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1})
+	manager, countedManager, countedMap := newRemovalCountingManager(t)
+	root, cancelRoot := inboundContext("alice", "192.0.2.84")
+	defer cancelRoot()
+
+	reserved, err := gateWithState(root, countedManager, state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nested := context.WithValue(reserved, struct{ name string }{"validation-nested"}, true)
+	deeper := context.WithValue(nested, struct{ name string }{"validation-deeper"}, true)
+	for _, ctx := range []context.Context{nested, deeper} {
+		got, err := gateWithState(ctx, countedManager, state)
+		if err != nil {
+			t.Fatalf("nested context was rejected: %v", err)
+		}
+		if got != ctx {
+			t.Fatal("nested gate changed the already reserved context")
+		}
+		if !Reserved(got, "alice", "192.0.2.84") {
+			t.Fatal("nested context lost the inherited reservation marker")
+		}
+	}
+	assertOnlineCount(t, manager, validationOnlineMapName, 1)
+
+	cancelRoot()
+	waitRemovalCount(t, countedMap, 1)
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+	if got := countedMap.removals.Load(); got != 1 {
+		t.Fatalf("nested context path invoked RemoveIP %d times, want exactly once", got)
+	}
+}
+
+func TestValidationUnmanagedAccountsDoNotConsumeOrReleaseManagedReservation(t *testing.T) {
+	state := stateWithCaps(t, map[string]int{"alice": 1, "bob": 0})
+	manager := newStatsManager(t)
+	managed, cancelManaged := inboundContext("alice", "192.0.2.85")
+	defer cancelManaged()
+	if _, err := gateWithState(managed, manager, state); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, email := range []string{"unlisted", "bob"} {
+		unmanaged, cancelUnmanaged := inboundContext(email, "invalid-source-is-ignored")
+		got, err := gateWithState(unmanaged, manager, state)
+		if err != nil || got != unmanaged || Reserved(got, email, "invalid-source-is-ignored") {
+			cancelUnmanaged()
+			t.Fatalf("unlimited account %q did not follow the stock path: ctx=%v err=%v", email, got, err)
+		}
+		cancelUnmanaged()
+		assertOnlineCount(t, manager, validationOnlineMapName, 1)
+	}
+
+	blocked, cancelBlocked := inboundContext("alice", "192.0.2.86")
+	defer cancelBlocked()
+	if _, err := gateWithState(blocked, manager, state); err == nil {
+		t.Fatal("unmanaged account cancellation released the managed account's reservation")
+	}
+	cancelManaged()
+	waitOnlineCount(t, manager, validationOnlineMapName, 0)
+}
+
+type removalCountingManager struct {
+	featurestats.Manager
+	online *removalCountingOnlineMap
+}
+
+func (m *removalCountingManager) GetOrRegisterOnlineMap(string) (featurestats.OnlineMap, error) {
+	return m.online, nil
+}
+
+type removalCountingOnlineMap struct {
+	featurestats.OnlineMap
+	reserver ipReserver
+	removals atomic.Int64
+}
+
+func (m *removalCountingOnlineMap) TryAddIP(ip string, limit int) bool {
+	return m.reserver.TryAddIP(ip, limit)
+}
+
+func (m *removalCountingOnlineMap) RemoveIP(ip string) {
+	m.OnlineMap.RemoveIP(ip)
+	m.removals.Add(1)
+}
+
+func newRemovalCountingManager(t *testing.T) (*appstats.Manager, *removalCountingManager, *removalCountingOnlineMap) {
+	t.Helper()
+	manager := newStatsManager(t)
+	online, err := manager.GetOrRegisterOnlineMap(validationOnlineMapName)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reserver, ok := online.(ipReserver)
+	if !ok {
+		t.Fatalf("stats online map %T does not support test reservations", online)
+	}
+	countedMap := &removalCountingOnlineMap{OnlineMap: online, reserver: reserver}
+	countedManager := &removalCountingManager{Manager: manager, online: countedMap}
+	return manager, countedManager, countedMap
+}
+
+func waitRemovalCount(t *testing.T, online *removalCountingOnlineMap, want int) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if got := online.removals.Load(); got >= int64(want) {
+			if got != int64(want) {
+				t.Fatalf("RemoveIP callback count = %d, want exactly %d", got, want)
+			}
+			return
+		}
+		runtime.Gosched()
+		time.Sleep(100 * time.Microsecond)
+	}
+	t.Fatalf("timed out waiting for %d RemoveIP callbacks; got %d", want, online.removals.Load())
+}
+
+func runAlternatingReservationBatches(t *testing.T, manager *appstats.Manager, countedManager *removalCountingManager, countedMap *removalCountingOnlineMap, state *policyState, batches, batchSize, priorRemovals int) {
+	t.Helper()
+	ips := [2]string{"192.0.2.90", "192.0.2.91"}
+	wantRemovals := priorRemovals
+	for batch := 0; batch < batches; batch++ {
+		contexts := make([]context.Context, batchSize)
+		cancels := make([]context.CancelFunc, batchSize)
+		for i := 0; i < batchSize; i++ {
+			ip := ips[(batch*batchSize+i)&1]
+			ctx, cancel := inboundContext("alice", ip)
+			contexts[i], cancels[i] = ctx, cancel
+			reserved, err := gateWithState(ctx, countedManager, state)
+			if err != nil {
+				t.Fatalf("batch %d reservation %d for %s failed: %v", batch, i, ip, err)
+			}
+			if !Reserved(reserved, "alice", ip) {
+				t.Fatalf("batch %d reservation %d for %s has no marker", batch, i, ip)
+			}
+		}
+		if got := manager.GetOnlineMap(validationOnlineMapName).Count(); got != len(ips) {
+			t.Fatalf("batch %d active unique-IP count = %d, want %d", batch, got, len(ips))
+		}
+		for _, cancel := range cancels {
+			cancel()
+		}
+		wantRemovals += batchSize
+		waitRemovalCount(t, countedMap, wantRemovals)
+		waitOnlineCount(t, manager, validationOnlineMapName, 0)
+		contexts = nil
+		cancels = nil
+	}
+}
+
+func settleValidationRuntime() {
+	for i := 0; i < 4; i++ {
+		runtime.GC()
+		runtime.Gosched()
+		time.Sleep(10 * time.Millisecond)
+	}
+}
diff --git a/common/nativeiplimit/validation_policy_gaps_test.go b/common/nativeiplimit/validation_policy_gaps_test.go

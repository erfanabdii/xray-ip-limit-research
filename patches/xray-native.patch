+// TryAddIP increments the reference count for ip if its unique-IP limit allows
+// it. The check and reservation share the same lock as AddIP, so concurrent
+// new addresses cannot exceed a positive limit. An already-present address is
+// always admitted, even when the map is at or above the limit.
+func (om *OnlineMap) TryAddIP(ip string, limit int) bool {
+	if ip == localhostIPv4 || ip == localhostIPv6 {
+		return false
+	}
+
+	now := time.Now().Unix()
+	om.access.Lock()
+	defer om.access.Unlock()
+	if e, ok := om.entries[ip]; ok {
+		e.refCount++
+		e.lastSeen = now
+		om.entries[ip] = e
+		return true
+	}
+	if limit > 0 && len(om.entries) >= limit {
+		return false
+	}
+	om.entries[ip] = ipEntry{
+		refCount: 1,
+		lastSeen: now,
+	}
+	om.count.Add(1)
+	return true
+}

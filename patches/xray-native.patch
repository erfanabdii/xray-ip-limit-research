@@ -0,0 +1,73 @@
+package stats
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestOnlineMapTryAddIPConcurrentLimit(t *testing.T) {
+	om := NewOnlineMap()
+	const limit = 7
+	const attempts = 64
+
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	accepted := 0
+	for i := 0; i < attempts; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if om.TryAddIP(fmt.Sprintf("192.0.2.%d", i+1), limit) {
+				mu.Lock()
+				accepted++
+				mu.Unlock()
+			}
+		}(i)
+	}
+	wg.Wait()
+
+	if accepted != limit {
+		t.Fatalf("accepted %d new IPs, want %d", accepted, limit)
+	}
+	if got := om.Count(); got != limit {
+		t.Fatalf("count = %d, want %d", got, limit)
+	}
+}
+
+func TestOnlineMapTryAddIPKnownAddressAndRelease(t *testing.T) {
+	om := NewOnlineMap()
+	const address = "192.0.2.10"
+	const otherAddress = "192.0.2.11"
+	const reservations = 32
+	if !om.TryAddIP(address, 1) {
+		t.Fatal("first IP was rejected")
+	}
+	om.AddIP(otherAddress)
+
+	var wg sync.WaitGroup
+	for i := 0; i < reservations; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if !om.TryAddIP(address, 1) {
+				t.Error("known IP was rejected at its limit")
+			}
+		}()
+	}
+	wg.Wait()
+	if got := om.Count(); got != 2 {
+		t.Fatalf("count after same-IP reservations = %d, want 2", got)
+	}
+
+	for i := 0; i < reservations+1; i++ {
+		om.RemoveIP(address)
+	}
+	if got := om.Count(); got != 1 {
+		t.Fatalf("count after releasing one address = %d, want 1", got)
+	}
+	om.RemoveIP(otherAddress)
+	if got := om.Count(); got != 0 {
+		t.Fatalf("count after releases = %d, want 0", got)
+	}
+}
diff --git a/common/nativeiplimit/nativeiplimit.go b/common/nativeiplimit/nativeiplimit.go
new file mode 100644
--- /dev/null
+++ b/common/nativeiplimit/nativeiplimit.go
@@ -0,0 +1,290 @@
+// Package nativeiplimit implements an optional, locally configured native
+// unique-IP admission limit for selected authenticated users.
+package nativeiplimit
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/stats"
+)
+
+const (
+	policyEmailsEnv = "XRAY_NATIVE_IP_LIMIT_EMAILS"
+	policyFileEnv   = "XRAY_NATIVE_IP_LIMIT_FILE"
+	maxPolicyBytes  = 64 * 1024
+	watchInterval   = 2 * time.Second
+)
+
+type policySnapshot struct {
+	users map[string]int
+}
+
+type policyDocument struct {
+	Version int            `json:"version"`
+	Users   map[string]int `json:"users"`
+}
+
+type fileStamp struct {
+	info    os.FileInfo
+	size    int64
+	modTime int64
+}
+
+type policyState struct {
+	allowlist map[string]struct{}
+	path      string
+	snapshot  atomic.Pointer[policySnapshot]
+
+	mu          sync.Mutex
+	last        fileStamp
+	haveLast    bool
+	lastStatErr bool
+}
+
+var activePolicy = newPolicyState(nil, "")
+
+type reservationContextKey struct{}
+
+type reservationMarker struct {
+	email string
+	ip    string
+}
+
+type ipReserver interface {
+	TryAddIP(string, int) bool
+}
+
+func init() {
+	value, emailsSet := os.LookupEnv(policyEmailsEnv)
+	path, pathSet := os.LookupEnv(policyFileEnv)
+	if !emailsSet || !pathSet || value == "" || path == "" {
+		return
+	}
+
+	allowlist, err := parseAllowlist(value)
+	if err != nil {
+		log.Printf("native IP limit disabled: invalid %s: %v", policyEmailsEnv, err)
+		return
+	}
+
+	activePolicy = newPolicyState(allowlist, path)
+	if err := activePolicy.initialize(); err != nil {
+		log.Printf("native IP limit disabled until a valid policy is available: %v", err)
+	}
+	go activePolicy.watch()
+}
+
+func newPolicyState(allowlist map[string]struct{}, path string) *policyState {
+	copyAllowlist := make(map[string]struct{}, len(allowlist))
+	for email := range allowlist {
+		copyAllowlist[email] = struct{}{}
+	}
+	s := &policyState{allowlist: copyAllowlist, path: path}
+	s.snapshot.Store(&policySnapshot{users: map[string]int{}})
+	return s
+}
+
+func parseAllowlist(value string) (map[string]struct{}, error) {
+	allowlist := make(map[string]struct{})
+	for _, item := range strings.Split(value, ",") {
+		email := strings.TrimSpace(item)
+		if email == "" {
+			return nil, fmt.Errorf("email allowlist contains an empty entry")
+		}
+		allowlist[email] = struct{}{}
+	}
+	return allowlist, nil
+}
+
+func (s *policyState) initialize() error {
+	if s.path == "" || len(s.allowlist) == 0 {
+		return nil
+	}
+	_, err := s.reloadIfChanged()
+	return err
+}
+
+func (s *policyState) watch() {
+	if s.path == "" || len(s.allowlist) == 0 {
+		return
+	}
+	ticker := time.NewTicker(watchInterval)
+	defer ticker.Stop()
+	for range ticker.C {
+		changed, err := s.reloadIfChanged()
+		if changed && err != nil {
+			log.Printf("native IP limit policy update ignored: %v", err)
+		}
+	}
+}
+
+func (s *policyState) reloadIfChanged() (bool, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	info, err := os.Stat(s.path)
+	if err != nil {
+		changed := !s.lastStatErr || s.haveLast
+		s.lastStatErr = true
+		s.haveLast = false
+		return changed, fmt.Errorf("stat policy file: %w", err)
+	}
+
+	stamp := fileStamp{info: info, size: info.Size(), modTime: info.ModTime().UnixNano()}
+	changed := s.lastStatErr || !s.haveLast || !sameStamp(s.last, stamp)
+	if !changed {
+		return false, nil
+	}
+	s.last = stamp
+	s.haveLast = true
+	s.lastStatErr = false
+
+	snapshot, err := readPolicyFile(s.path, s.allowlist)
+	if err != nil {
+		return true, err
+	}
+	s.snapshot.Store(snapshot)
+	return true, nil
+}
+
+func sameStamp(a, b fileStamp) bool {
+	return os.SameFile(a.info, b.info) && a.size == b.size && a.modTime == b.modTime
+}
+
+func (s *policyState) applyFile() error {
+	snapshot, err := readPolicyFile(s.path, s.allowlist)
+	if err != nil {
+		return err
+	}
+	s.snapshot.Store(snapshot)
+	return nil
+}
+
+func readPolicyFile(path string, allowlist map[string]struct{}) (*policySnapshot, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("open policy file: %w", err)
+	}
+	defer file.Close()
+
+	data, err := io.ReadAll(io.LimitReader(file, maxPolicyBytes+1))
+	if err != nil {
+		return nil, fmt.Errorf("read policy file: %w", err)
+	}
+	if len(data) > maxPolicyBytes {
+		return nil, fmt.Errorf("policy file exceeds %d bytes", maxPolicyBytes)
+	}
+
+	decoder := json.NewDecoder(strings.NewReader(string(data)))
+	decoder.DisallowUnknownFields()
+	var document policyDocument
+	if err := decoder.Decode(&document); err != nil {
+		return nil, fmt.Errorf("decode policy file: %w", err)
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		if err == nil {
+			return nil, fmt.Errorf("policy file contains trailing JSON")
+		}
+		return nil, fmt.Errorf("decode policy trailer: %w", err)
+	}
+	if document.Version != 1 {
+		return nil, fmt.Errorf("unsupported policy version %d", document.Version)
+	}
+	if document.Users == nil {
+		return nil, fmt.Errorf("policy users must be an object")
+	}
+
+	users := make(map[string]int, len(document.Users))
+	for email, limit := range document.Users {
+		if _, ok := allowlist[email]; !ok {
+			return nil, fmt.Errorf("policy user %q is outside the configured email allowlist", email)
+		}
+		if limit < 0 {
+			return nil, fmt.Errorf("policy limit for %q must be nonnegative", email)
+		}
+		users[email] = limit
+	}
+	return &policySnapshot{users: users}, nil
+}
+
+// Gate reserves one unique source IP for a scoped authenticated user before
+// routing begins. Users without a positive configured limit follow the stock
+// path without map lookup or reservation work.
+func Gate(ctx context.Context, manager stats.Manager) (context.Context, error) {
+	return gateWithState(ctx, manager, activePolicy)
+}
+
+func gateWithState(ctx context.Context, manager stats.Manager, state *policyState) (context.Context, error) {
+	if ctx == nil {
+		return nil, fmt.Errorf("native IP limit received a nil context")
+	}
+	inbound := session.InboundFromContext(ctx)
+	if inbound == nil || inbound.User == nil || inbound.User.Email == "" || state == nil {
+		return ctx, nil
+	}
+
+	snapshot := state.snapshot.Load()
+	if snapshot == nil {
+		return ctx, nil
+	}
+	limit, configured := snapshot.users[inbound.User.Email]
+	if !configured || limit <= 0 {
+		return ctx, nil
+	}
+
+	address := inbound.Source.Address
+	if address == nil || !address.Family().IsIP() || address.IP() == nil {
+		return nil, fmt.Errorf("native IP limit requires a valid source IP for user %q", inbound.User.Email)
+	}
+	ip := address.String()
+	parsedIP := address.IP()
+	if parsedIP.Equal(net.ParseIP("127.0.0.1")) || parsedIP.Equal(net.ParseIP("::1")) {
+		return nil, fmt.Errorf("native IP limit rejects localhost source for user %q", inbound.User.Email)
+	}
+	if Reserved(ctx, inbound.User.Email, ip) {
+		return ctx, nil
+	}
+	if manager == nil {
+		return nil, fmt.Errorf("native IP limit stats manager is unavailable for user %q", inbound.User.Email)
+	}
+
+	name := "user>>>" + inbound.User.Email + ">>>online"
+	onlineMap, err := manager.GetOrRegisterOnlineMap(name)
+	if err != nil || onlineMap == nil {
+		if err != nil {
+			return nil, fmt.Errorf("native IP limit online map unavailable for user %q: %w", inbound.User.Email, err)
+		}
+		return nil, fmt.Errorf("native IP limit online map unavailable for user %q", inbound.User.Email)
+	}
+	reserver, ok := onlineMap.(ipReserver)
+	if !ok {
+		return nil, fmt.Errorf("native IP limit online map cannot reserve IPs for user %q", inbound.User.Email)
+	}
+	if !reserver.TryAddIP(ip, limit) {
+		return nil, fmt.Errorf("native IP limit reached for user %q", inbound.User.Email)
+	}
+
+	context.AfterFunc(ctx, func() { onlineMap.RemoveIP(ip) })
+	return context.WithValue(ctx, reservationContextKey{}, reservationMarker{email: inbound.User.Email, ip: ip}), nil
+}
+
+// Reserved reports whether ctx already carries this exact account/IP
+// reservation. The marker is inherited by child mux contexts.
+func Reserved(ctx context.Context, email, ip string) bool {
+	if ctx == nil {
+		return false
+	}
+	marker, ok := ctx.Value(reservationContextKey{}).(reservationMarker)
+	return ok && marker.email == email && marker.ip == ip
+}

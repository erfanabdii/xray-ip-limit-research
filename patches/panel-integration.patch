diff --git a/internal/web/job/native_ip_limit.go b/internal/web/job/native_ip_limit.go
new file mode 100644
--- /dev/null
+++ b/internal/web/job/native_ip_limit.go
@@ -0,0 +1,194 @@
+package job
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/logger"
+	"gorm.io/gorm"
+)
+
+const (
+	nativeIPLimitEmailsEnv = "XRAY_NATIVE_IP_LIMIT_EMAILS"
+	nativeIPLimitFileEnv   = "XRAY_NATIVE_IP_LIMIT_FILE"
+)
+
+type nativeIPLimitConfig struct {
+	emails []string
+	path   string
+}
+
+type nativeIPLimitPolicy struct {
+	Version int            `json:"version"`
+	Users   map[string]int `json:"users"`
+}
+
+// nativeIPLimitConfigFromEnv leaves the stock path untouched unless both
+// opt-in variables are present. Email spelling is preserved exactly.
+func nativeIPLimitConfigFromEnv() (nativeIPLimitConfig, bool) {
+	rawEmails, emailsSet := os.LookupEnv(nativeIPLimitEmailsEnv)
+	rawPath, pathSet := os.LookupEnv(nativeIPLimitFileEnv)
+	if !emailsSet || !pathSet {
+		return nativeIPLimitConfig{}, false
+	}
+
+	config := nativeIPLimitConfig{emails: parseNativeIPLimitEmails(rawEmails), path: strings.TrimSpace(rawPath)}
+	return config, true
+}
+
+func parseNativeIPLimitEmails(raw string) []string {
+	seen := make(map[string]struct{})
+	emails := make([]string, 0)
+	for _, email := range strings.Split(raw, ",") {
+		email = strings.TrimSpace(email)
+		if email == "" {
+			continue
+		}
+		if _, exists := seen[email]; exists {
+			continue
+		}
+		seen[email] = struct{}{}
+		emails = append(emails, email)
+	}
+	return emails
+}
+
+// publishNativeIPLimitPolicy runs before the online-stats and fail2ban gates.
+// Once environment scope is valid, the emails remain legacy-managed even if
+// publishing fails: the core may still hold its last valid native policy, and
+// re-enabling legacy enforcement could overlap it.
+func (j *CheckClientIpJob) publishNativeIPLimitPolicy() map[string]struct{} {
+	config, configured := nativeIPLimitConfigFromEnv()
+	if !configured {
+		return nil
+	}
+	if len(config.emails) == 0 || config.path == "" {
+		j.logNativeIPLimitPublishError(errors.New("both native IP limit settings must be non-empty"))
+		return nil
+	}
+	managed := nativeIPLimitEmailScope(config.emails)
+
+	policy, err := loadNativeIPLimitPolicy(database.GetDB(), config.emails)
+	if err != nil {
+		j.logNativeIPLimitPublishError(err)
+		return managed
+	}
+	content, err := json.Marshal(policy)
+	if err != nil {
+		j.logNativeIPLimitPublishError(err)
+		return managed
+	}
+	if _, err := writeNativeIPLimitPolicy(config.path, content); err != nil {
+		j.logNativeIPLimitPublishError(err)
+		return managed
+	}
+
+	j.nativePolicyErrorLogged = false
+	return managed
+}
+
+func nativeIPLimitEmailScope(emails []string) map[string]struct{} {
+	managed := make(map[string]struct{}, len(emails))
+	for _, email := range emails {
+		managed[email] = struct{}{}
+	}
+	return managed
+}
+
+func (j *CheckClientIpJob) logNativeIPLimitPublishError(err error) {
+	if j.nativePolicyErrorLogged {
+		return
+	}
+	j.nativePolicyErrorLogged = true
+	logger.Warning("[NativeIPLimit] policy publish failed:", err)
+}
+
+// loadNativeIPLimitPolicy selects only configured indexed emails and copies
+// only their normalized cap and enable state into the native policy.
+func loadNativeIPLimitPolicy(db *gorm.DB, emails []string) (nativeIPLimitPolicy, error) {
+	if db == nil {
+		return nativeIPLimitPolicy{}, errors.New("database is unavailable")
+	}
+	type clientCap struct {
+		Email   string
+		LimitIP int
+		Enable  bool
+	}
+	var rows []clientCap
+	if err := db.Model(&model.ClientRecord{}).
+		Select("email, limit_ip, enable").
+		Where("email IN ?", emails).
+		Scan(&rows).Error; err != nil {
+		return nativeIPLimitPolicy{}, fmt.Errorf("read configured client limits: %w", err)
+	}
+
+	users := make(map[string]int, len(emails))
+	for _, email := range emails {
+		users[email] = 0
+	}
+	for _, row := range rows {
+		_, configured := users[row.Email]
+		if !configured || !row.Enable || row.LimitIP <= 0 {
+			continue
+		}
+		users[row.Email] = row.LimitIP
+	}
+	return nativeIPLimitPolicy{Version: 1, Users: users}, nil
+}
+
+// writeNativeIPLimitPolicy atomically replaces path only when its bytes differ.
+func writeNativeIPLimitPolicy(path string, content []byte) (bool, error) {
+	if strings.TrimSpace(path) == "" {
+		return false, errors.New("native IP limit policy path is empty")
+	}
+	current, err := os.ReadFile(path)
+	if err == nil && bytes.Equal(current, content) {
+		return false, nil
+	}
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return false, fmt.Errorf("read existing policy: %w", err)
+	}
+
+	dir := filepath.Dir(path)
+	tmp, err := os.CreateTemp(dir, "."+filepath.Base(path)+".tmp-*")
+	if err != nil {
+		return false, fmt.Errorf("create policy temp file: %w", err)
+	}
+	tmpPath := tmp.Name()
+	closed, renamed := false, false
+	defer func() {
+		if !closed {
+			_ = tmp.Close()
+		}
+		if !renamed {
+			_ = os.Remove(tmpPath)
+		}
+	}()
+
+	if err := tmp.Chmod(0o600); err != nil {
+		return false, fmt.Errorf("set policy temp file mode: %w", err)
+	}
+	if _, err := tmp.Write(content); err != nil {
+		return false, fmt.Errorf("write policy temp file: %w", err)
+	}
+	if err := tmp.Sync(); err != nil {
+		return false, fmt.Errorf("sync policy temp file: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		closed = true
+		return false, fmt.Errorf("close policy temp file: %w", err)
+	}
+	closed = true
+	if err := os.Rename(tmpPath, path); err != nil {
+		return false, fmt.Errorf("replace policy file: %w", err)
+	}
+	renamed = true
+	return true, nil
+}

+package job
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+)
+
+func TestPublishNativeIPLimitPolicyRequiresBothSettings(t *testing.T) {
+	t.Setenv(nativeIPLimitEmailsEnv, "alice")
+	previousPath, pathWasSet := os.LookupEnv(nativeIPLimitFileEnv)
+	if err := os.Unsetenv(nativeIPLimitFileEnv); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if pathWasSet {
+			_ = os.Setenv(nativeIPLimitFileEnv, previousPath)
+		} else {
+			_ = os.Unsetenv(nativeIPLimitFileEnv)
+		}
+	})
+
+	if _, configured := nativeIPLimitConfigFromEnv(); configured {
+		t.Fatal("missing policy path must leave the native publisher disabled")
+	}
+	if managed := (&CheckClientIpJob{}).publishNativeIPLimitPolicy(); managed != nil {
+		t.Fatalf("publisher must leave the stock path active without both settings, got managed scope %v", managed)
+	}
+}
+
+func TestPublishNativeIPLimitPolicyUsesOnlyExactConfiguredRecords(t *testing.T) {
+	setupIntegrationDB(t)
+	policyDir := filepath.Join(t.TempDir(), "native")
+	if err := os.Mkdir(policyDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	policyPath := filepath.Join(policyDir, "policy.json")
+	t.Setenv(nativeIPLimitEmailsEnv, "alice, Alice, unlimited, disabled, missing")
+	t.Setenv(nativeIPLimitFileEnv, policyPath)
+
+	records := []model.ClientRecord{
+		{Email: "alice", LimitIP: 2, Enable: true, UUID: "uuid-secret", Password: "password-secret"},
+		{Email: "unlimited", LimitIP: 0, Enable: true},
+		{Email: "disabled", LimitIP: 8, Enable: false},
+		{Email: "other", LimitIP: 99, Enable: true, UUID: "other-secret"},
+	}
+	if err := database.GetDB().Create(&records).Error; err != nil {
+		t.Fatalf("seed client records: %v", err)
+	}
+	if err := database.GetDB().Model(&model.ClientRecord{}).Where("email = ?", "disabled").Update("enable", false).Error; err != nil {
+		t.Fatalf("disable client record: %v", err)
+	}
+
+	managed := (&CheckClientIpJob{}).publishNativeIPLimitPolicy()
+	wantManaged := map[string]struct{}{
+		"alice": {}, "Alice": {}, "unlimited": {}, "disabled": {}, "missing": {},
+	}
+	if !reflect.DeepEqual(managed, wantManaged) {
+		t.Fatalf("managed scope mismatch\ngot:  %v\nwant: %v", managed, wantManaged)
+	}
+
+	content, err := os.ReadFile(policyPath)
+	if err != nil {
+		t.Fatalf("read published policy: %v", err)
+	}
+	var policy nativeIPLimitPolicy
+	if err := json.Unmarshal(content, &policy); err != nil {
+		t.Fatalf("unmarshal published policy: %v", err)
+	}
+	wantUsers := map[string]int{"alice": 2, "Alice": 0, "unlimited": 0, "disabled": 0, "missing": 0}
+	if policy.Version != 1 || !reflect.DeepEqual(policy.Users, wantUsers) {
+		t.Fatalf("unexpected policy: version=%d users=%v", policy.Version, policy.Users)
+	}
+	for _, secret := range []string{"other", "uuid-secret", "password-secret", "other-secret"} {
+		if strings.Contains(string(content), secret) {
+			t.Fatalf("policy leaked unconfigured or credential data %q: %s", secret, content)
+		}
+	}
+	if runtime.GOOS != "windows" {
+		info, err := os.Stat(policyPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := info.Mode().Perm(); got != 0o600 {
+			t.Fatalf("policy mode = %04o, want 0600", got)
+		}
+	}
+}
+
+func TestWriteNativeIPLimitPolicyAtomicAndSkipsUnchangedContent(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "policy.json")
+	first := []byte(`{"version":1,"users":{"alice":1}}`)
+	changed, err := writeNativeIPLimitPolicy(path, first)
+	if err != nil || !changed {
+		t.Fatalf("initial write changed=%v err=%v", changed, err)
+	}
+	firstInfo, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	changed, err = writeNativeIPLimitPolicy(path, first)
+	if err != nil || changed {
+		t.Fatalf("unchanged write changed=%v err=%v, want no rewrite", changed, err)
+	}
+	secondInfo, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !os.SameFile(firstInfo, secondInfo) {
+		t.Fatal("unchanged policy was rewritten")
+	}
+
+	second := []byte(`{"version":1,"users":{"alice":2}}`)
+	changed, err = writeNativeIPLimitPolicy(path, second)
+	if err != nil || !changed {
+		t.Fatalf("changed content write changed=%v err=%v", changed, err)
+	}
+	got, err := os.ReadFile(path)
+	if err != nil || string(got) != string(second) {
+		t.Fatalf("replacement content = %q, err=%v", got, err)
+	}
+}
+
+func TestProcessObservedManagedNativeEmailCollectsWithoutLegacyEnforcement(t *testing.T) {
+	setupIntegrationDB(t)
+
+	const email = "alice"
+	seedLinkedInboundWithClient(t, "native-managed-inbound", email, 1)
+	seedClientIps(t, email, []IPWithTimestamp{{IP: "192.0.2.10", Timestamp: time.Now().Unix()}})
+
+	observed := map[string]map[string]int64{
+		email: {
+			"192.0.2.10":    time.Now().Unix(),
+			"198.51.100.20": time.Now().Unix(),
+		},
+	}
+	(&CheckClientIpJob{}).processObservedWithManagedEmails(observed, true, true, map[string]struct{}{email: {}})
+
+	got := ipSet(readClientIps(t, email))
+	if len(got) != 2 {
+		t.Fatalf("managed email should retain both observed IPs for panel display, got %v", got)
+	}
+	if info, err := os.Stat(readIpLimitLogPath()); err == nil && info.Size() > 0 {
+		body, _ := os.ReadFile(readIpLimitLogPath())
+		t.Fatalf("managed email must not queue legacy bans or temporary removals, got:\n%s", body)
+	}
+}
+
+func TestNativePolicyWriteFailureKeepsEmailOutOfLegacyEnforcement(t *testing.T) {
+	setupIntegrationDB(t)
+
+	const email = "alice"
+	seedLinkedInboundWithClient(t, "native-managed-write-failure", email, 1)
+	seedClientIps(t, email, []IPWithTimestamp{{IP: "192.0.2.30", Timestamp: time.Now().Unix()}})
+	t.Setenv(nativeIPLimitEmailsEnv, email)
+	t.Setenv(nativeIPLimitFileEnv, filepath.Join(t.TempDir(), "missing", "policy.json"))
+
+	job := &CheckClientIpJob{}
+	managed := job.publishNativeIPLimitPolicy()
+	if _, ok := managed[email]; !ok || len(managed) != 1 {
+		t.Fatalf("failed publication must preserve the configured managed scope, got %v", managed)
+	}
+
+	observed := map[string]map[string]int64{
+		email: {
+			"192.0.2.30":    time.Now().Unix(),
+			"198.51.100.30": time.Now().Unix(),
+		},
+	}
+	job.processObservedWithManagedEmails(observed, true, true, managed)
+
+	if got := ipSet(readClientIps(t, email)); len(got) != 2 {
+		t.Fatalf("failed publication must still preserve both displayed IPs, got %v", got)
+	}
+	if info, err := os.Stat(readIpLimitLogPath()); err == nil && info.Size() > 0 {
+		body, _ := os.ReadFile(readIpLimitLogPath())
+		t.Fatalf("failed publication must not re-enable legacy bans or temporary removals, got:\n%s", body)
+	}
+}

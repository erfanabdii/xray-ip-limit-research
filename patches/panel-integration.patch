@@ -0,0 +1,42 @@
+package job
+
+import (
+	"testing"
+	"time"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+)
+
+// Deterministic reproduction of the legacy union's freshness boundary. The
+// remote IP is stipulated to belong to an ongoing flow whose LastSeen remains
+// its admission timestamp, as the core stores it. This does not assert that a
+// particular deployment flow has this shape.
+func TestValidationLegacyRemoteFreshnessBoundary(t *testing.T) {
+	for _, remoteAge := range []time.Duration{30 * time.Second, 121 * time.Second} {
+		t.Run(remoteAge.String(), func(t *testing.T) {
+			setupIntegrationDB(t)
+			const email = "fixture-global"
+			now := time.Now().Unix()
+			inbound := seedLinkedInboundWithClient(t, "fixture-global", email, 1)
+			row := seedClientIps(t, email, []IPWithTimestamp{{IP: "198.51.100.20", Timestamp: now - int64(remoteAge/time.Second)}})
+			candidates, kept := (&CheckClientIpJob{}).updateInboundClientIps(database.GetDB(), row, inbound, email, 1,
+				[]IPWithTimestamp{{IP: "192.0.2.10", Timestamp: now}}, true, true)
+			wantCandidates := 1
+			if remoteAge > 120*time.Second {
+				wantCandidates = 0
+			}
+			if len(candidates) != wantCandidates || kept != 1 {
+				t.Fatalf("remoteAge=%s candidates=%d kept=%d, want candidates=%d kept=1", remoteAge, len(candidates), kept, wantCandidates)
+			}
+			t.Logf("remoteAge=%s, excess-IP candidates=%d; no ban publication or external command invoked", remoteAge, len(candidates))
+		})
+	}
+}
+
+func TestValidationPanelScopeDropsTrailingComma(t *testing.T) {
+	got := parseNativeIPLimitEmails("alice,")
+	if len(got) != 1 || got[0] != "alice" {
+		t.Fatalf("panel parser behavior changed: %v", got)
+	}
+	t.Log("CONFIRMED MISMATCH: panel accepts trailing comma that disables core native setup; no active settings changed")
+}

+func TestRestartRecoveryWaitsForEmptyScopedSnapshot(t *testing.T) {
+	online := true
+	fake := &fakeStatsClient{get: func() (*statscommand.GetUsersStatsResponse, error) {
+		if online {
+			return responseWith(user("fixture-a@example.invalid", "198.51.100.10")), nil
+		}
+		return responseWith(), nil
+	}}
+	c := newController(fixtureConfig(), []statscommand.StatsServiceClient{fake})
+	if c.admit("fixture-b@example.invalid", "198.51.100.10") {
+		t.Fatal("new process must deny while recovering")
+	}
+	c.pollOnce(context.Background())
+	if !c.status().Recovering {
+		t.Fatal("recovery must continue while a scoped account is online")
+	}
+	if c.admit("fixture-b@example.invalid", "198.51.100.10") {
+		t.Fatal("recovery state must deny admissions")
+	}
+	online = false
+	c.pollOnce(context.Background())
+	if status := c.status(); status.Recovering || !status.Healthy {
+		t.Fatalf("empty complete snapshot should finish recovery: %+v", status)
+	}
+	if !c.admit("fixture-b@example.invalid", "198.51.100.10") {
+		t.Fatal("admission should work after empty recovery snapshot")
+	}
+}

+func TestSnapshotErrorRetainsOwnersAndDeniesAdmissionsUntilRecovery(t *testing.T) {
+	offline := true
+	fake := &fakeStatsClient{get: func() (*statscommand.GetUsersStatsResponse, error) {
+		if offline {
+			return nil, errors.New("fixture API unavailable")
+		}
+		return responseWith(user("fixture-a@example.invalid", "198.51.100.10")), nil
+	}}
+	c := testController(fixtureConfig(), fake)
+	owner := grant{"fixture-a@example.invalid", "198.51.100.10"}
+	c.owners[owner] = struct{}{}
+	c.pollOnce(context.Background())
+	if _, ok := c.owners[owner]; !ok {
+		t.Fatal("snapshot error must retain existing ownership")
+	}
+	if c.admit("fixture-b@example.invalid", "198.51.100.10") {
+		t.Fatal("unhealthy controller admitted a new pair")
+	}
+	if status := c.status(); status.Healthy || status.PollErrors != 1 {
+		t.Fatalf("snapshot failure did not mark controller unhealthy: %+v", status)
+	}
+
+	offline = false
+	c.pollOnce(context.Background())
+	if status := c.status(); !status.Healthy || len(status.Owners) != 1 {
+		t.Fatalf("successful snapshot did not restore health and retain observed owner: %+v", status)
+	}
+	if !c.admit("fixture-b@example.invalid", "198.51.100.10") {
+		t.Fatal("healthy controller should resume admissions")
+	}
+}

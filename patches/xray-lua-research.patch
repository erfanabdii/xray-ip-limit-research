+	}
+	if _, ok := c.owners[grant{"fixture-b@example.invalid", "198.51.100.11"}]; !ok {
+		t.Fatal("owner present on node 2 was pruned")
+	}
+	if _, ok := c.owners[grant{"fixture-a@example.invalid", "198.51.100.12"}]; ok {
+		t.Fatal("owner absent from the complete two-node snapshot was retained")
+	}
+	if status := c.status(); status.Releases != 1 || !status.Healthy || status.PollOK != 1 {
+		t.Fatalf("unexpected post-reconcile status: %+v", status)
+	}
+}

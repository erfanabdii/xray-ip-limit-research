+package router
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/lua"
+	"github.com/xtls/xray-core/common/net"
+	glua "github.com/yuin/gopher-lua"
+)
+
+func TestDiagnosticLuaRouteSeesUserAndSourceAndCanChooseBlockTag(t *testing.T) {
+	r := startLuaRouter(t, `
+function HandleRoute(ctx, inboundTag, sourcePort, targetPort, localPort,
+    targetDomain, network, protocol, user)
+    local sources = ctx:GetSourceIPs()
+    if user == "user@example.com" and #sources == 1 and
+        sources[1]:String() == "127.0.0.2" then
+        return "block", "lua-user-source-match"
+    end
+    return "allow", "lua-fallback"
+end`, nil, &Config{Rule: []*RoutingRule{{
+		TargetTag: &RoutingRule_Tag{Tag: "block"},
+		Networks:  []net.Network{net.Network_TCP},
+	}}})
+
+	route, err := r.PickRoute(newLuaRouteTestContext())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if route == nil || route.GetOutboundTag() != "block" || route.GetRuleTag() != "lua-user-source-match" {
+		t.Fatalf("route = %v; want configured block tag and Lua match rule", route)
+	}
+}
+
+func TestDiagnosticLuaPoolStatesDoNotShareNaiveAccountIPCap(t *testing.T) {
+	path := writeRouteScript(t, `
+accountIPs = {}
+function AdmitIP(user, ip, cap)
+    local ips = accountIPs[user]
+    if ips == nil then
+        ips = {}
+        accountIPs[user] = ips
+    end
+    if ips[ip] then return true end
+    local count = 0
+    for _ in pairs(ips) do count = count + 1 end
+    if count >= cap then return false end
+    ips[ip] = true
+    return true
+end`)
+	program, err := lua.CompileFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool, err := lua.NewPool(context.Background(), time.Second,
+		program.NewStateFactory(time.Second, nil, nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+
+	first, err := pool.Acquire(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Release(first, true)
+	second, err := pool.Acquire(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Release(second, true)
+	if first == second {
+		t.Fatal("simultaneous pool acquisitions returned the same Lua state")
+	}
+
+	firstAccepted := callDiagnosticLuaAdmit(t, first, "same-account", "198.51.100.10", 1)
+	secondAccepted := callDiagnosticLuaAdmit(t, second, "same-account", "198.51.100.11", 1)
+	if !firstAccepted || !secondAccepted {
+		t.Fatalf("diagnostic setup did not reproduce separate-state acceptance: first=%t second=%t", firstAccepted, secondAccepted)
+	}
+}
+
+func callDiagnosticLuaAdmit(t *testing.T, L *glua.LState, user, ip string, cap int) bool {
+	t.Helper()
+	fn := L.GetGlobal("AdmitIP")
+	if fn.Type() != glua.LTFunction {
+		t.Fatal("AdmitIP is not a Lua function")
+	}
+	if err := L.CallByParam(glua.P{Fn: fn, NRet: 1, Protect: true},
+		glua.LString(user), glua.LString(ip), glua.LNumber(cap)); err != nil {
+		t.Fatal(err)
+	}
+	result, ok := L.Get(-1).(glua.LBool)
+	L.Pop(1)
+	if !ok {
+		t.Fatal("AdmitIP did not return a boolean")
+	}
+	return bool(result)
+}
+
+func TestDiagnosticLuaPoolReuseRetainsGlobalsAndExposesNoLifecycleHook(t *testing.T) {
+	r := startLuaRouter(t, `
+routeContextHasNoLifecycleHooks = false
+function HandleRoute(ctx)
+    routeContextHasNoLifecycleHooks = ctx.Close == nil and ctx.Cancel == nil and
+        ctx.Done == nil and ctx.Release == nil and ctx.RefCount == nil and
+        ctx.AddRef == nil and ctx.RemoveRef == nil
+    assert(routeContextHasNoLifecycleHooks)
+    assert(package.preload["xray.stats"] == nil and package.loaded["xray.stats"] == nil)
+    return "block", "lua-diagnostic"
+end`, nil, nil)
+
+	route, err := r.PickRoute(newLuaRouteTestContext())
+	if err != nil || route == nil || route.GetOutboundTag() != "block" {
+		t.Fatalf("diagnostic routing = %v, %v; want block", route, err)
+	}
+
+	firstFixtureCtx, cancelFirstFixture := context.WithCancel(context.Background())
+	var firstState *glua.LState
+	var firstExecutionCtx context.Context
+	err = r.script.pool.WithState(firstFixtureCtx, time.Second, func(L *glua.LState) error {
+		firstState = L
+		firstExecutionCtx = L.Context()
+		if L.GetGlobal("routeContextHasNoLifecycleHooks") != glua.LTrue {
+			return errors.New("routing context exposed a close, cancel, or refcount hook")
+		}
+		if L.GetGlobal("poolProbeCount") != glua.LNil {
+			return errors.New("poolProbeCount was unexpectedly initialized")
+		}
+		L.SetGlobal("poolProbeCount", glua.LNumber(1))
+		packageTable, ok := L.GetGlobal("package").(*glua.LTable)
+		if !ok {
+			return errors.New("Lua package table is unavailable")
+		}
+		preload, ok := packageTable.RawGetString("preload").(*glua.LTable)
+		if !ok {
+			return errors.New("Lua package.preload table is unavailable")
+		}
+		loaded, ok := packageTable.RawGetString("loaded").(*glua.LTable)
+		if !ok {
+			return errors.New("Lua package.loaded table is unavailable")
+		}
+		if preload.RawGetString("xray.stats") != glua.LNil || loaded.RawGetString("xray.stats") != glua.LNil {
+			return errors.New("xray.stats is unexpectedly present in package.preload")
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancelFirstFixture()
+	if firstFixtureCtx.Err() == nil || firstExecutionCtx == nil || firstExecutionCtx.Err() == nil {
+		t.Fatal("first fixture/execution context did not end")
+	}
+	if firstState.Context() != nil {
+		t.Fatal("released Lua state retained its execution context")
+	}
+
+	secondFixtureCtx, cancelSecondFixture := context.WithCancel(context.Background())
+	defer cancelSecondFixture()
+	err = r.script.pool.WithState(secondFixtureCtx, time.Second, func(L *glua.LState) error {
+		if L != firstState {
+			return errors.New("pool did not reacquire the released Lua state")
+		}
+		if L.GetGlobal("poolProbeCount") != glua.LNumber(1) {
+			return errors.New("Lua globals did not survive release and reacquisition")
+		}
+		if L.Context() == nil || L.Context() == firstExecutionCtx {
+			return errors.New("reacquired Lua state did not receive a fresh execution context")
+		}
+		L.SetGlobal("poolProbeCount", glua.LNumber(2))
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/common/lua/validation_pass5_pool_test.go b/common/lua/validation_pass5_pool_test.go
new file mode 100644
--- /dev/null
+++ b/common/lua/validation_pass5_pool_test.go
@@ -0,0 +1,341 @@
+package lua
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	glua "github.com/yuin/gopher-lua"
+)
+
+const pass5LifecycleLua = `
+local lookup = {}
+for i = 1, 16 do
+	lookup[i] = i * 3 + 10
+end
+pass5_init()
+function route(k, x)
+	return x + lookup[k]
+end
+`
+
+const pass5CachedLookupLua = `
+local lookup = {}
+for i = 1, 16 do
+	lookup[i] = i * 3 + 10
+end
+function route(k, x)
+	return x + lookup[k]
+end
+`
+
+const pass5RebuiltLookupLua = `
+function route(k, x)
+	local lookup = {}
+	for i = 1, 16 do
+		lookup[i] = i * 3 + 10
+	end
+	return x + lookup[k]
+end
+`
+
+func pass5CompileFile(t testing.TB, name, source string) *Program {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(path, []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	program, err := CompileFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return program
+}
+
+func pass5CallRoute(L *glua.LState, key, input int) (int, error) {
+	fn := L.GetGlobal("route")
+	if fn.Type() != glua.LTFunction {
+		return 0, errors.New("Lua global route is not a function")
+	}
+	L.Push(fn)
+	L.Push(glua.LNumber(key))
+	L.Push(glua.LNumber(input))
+	if err := L.PCall(2, 1, nil); err != nil {
+		return 0, err
+	}
+	value := L.Get(-1)
+	L.Pop(1)
+	number, ok := value.(glua.LNumber)
+	if !ok {
+		return 0, fmt.Errorf("route returned %s, want number", value.Type())
+	}
+	return int(number), nil
+}
+
+func TestValidationPass5PoolCompileReuseBurstAndIdleCap(t *testing.T) {
+	program := pass5CompileFile(t, "lifecycle.lua", pass5LifecycleLua)
+	var created atomic.Int64
+	var topLevelRuns atomic.Int64
+	factory := func(ctx context.Context) (*glua.LState, error) {
+		state, err := program.NewState(ctx, func(L *glua.LState) {
+			L.SetGlobal("pass5_init", L.NewFunction(func(*glua.LState) int {
+				topLevelRuns.Add(1)
+				return 0
+			}))
+		}, nil)
+		if err == nil {
+			created.Add(1)
+		}
+		return state, err
+	}
+
+	pool, err := NewPool(context.Background(), time.Second, factory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(pool.Close)
+	if got := created.Load(); got != 1 {
+		t.Fatalf("NewPool created %d states, want its one initial state", got)
+	}
+	if got := topLevelRuns.Load(); got != 1 {
+		t.Fatalf("top-level ran %d times after NewPool, want once for its initial VM", got)
+	}
+
+	pool.mu.Lock()
+	seed := pool.idle[0]
+	pool.mu.Unlock()
+	var coldState *glua.LState
+	var coldContext context.Context
+	err = pool.WithState(nil, 0, func(L *glua.LState) error {
+		coldState = L
+		coldContext = L.Context()
+		got, err := pass5CallRoute(L, 7, 41)
+		if err == nil && got != 72 {
+			return fmt.Errorf("cold route returned %d, want 72", got)
+		}
+		return err
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if coldState != seed {
+		t.Fatal("first route call did not use NewPool's initialized state")
+	}
+	if !errors.Is(coldContext.Err(), context.Canceled) {
+		t.Fatalf("WithState did not run its deferred cancel after cold call: %v", coldContext.Err())
+	}
+
+	for i := 0; i < 16; i++ {
+		var warmState *glua.LState
+		err := pool.WithState(nil, 0, func(L *glua.LState) error {
+			warmState = L
+			got, err := pass5CallRoute(L, 7, 41)
+			if err == nil && got != 72 {
+				return fmt.Errorf("warm route returned %d, want 72", got)
+			}
+			return err
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if warmState != seed {
+			t.Fatalf("warm call %d did not reuse the seed VM", i)
+		}
+	}
+	if got := created.Load(); got != 1 {
+		t.Fatalf("cold and warm calls created %d states, want 1", got)
+	}
+	if got := topLevelRuns.Load(); got != 1 {
+		t.Fatalf("cold and warm calls ran top-level %d times, want 1", got)
+	}
+
+	const burstSize = 32
+	type acquireResult struct {
+		state *glua.LState
+		err   error
+	}
+
+	acquired := make(chan acquireResult, burstSize)
+	release := make(chan struct{})
+	released := make(chan *glua.LState, burstSize)
+	for i := 0; i < burstSize; i++ {
+		go func() {
+			state, err := pool.Acquire(nil)
+			acquired <- acquireResult{state: state, err: err}
+			if err != nil {
+				return
+			}
+			<-release
+			pool.Release(state, true)
+			released <- state
+		}()
+	}
+
+	borrowed := make([]*glua.LState, 0, burstSize)
+	var acquireErr error
+	for i := 0; i < burstSize; i++ {
+		result := <-acquired
+		if result.err != nil {
+			if acquireErr == nil {
+				acquireErr = result.err
+			}
+			continue
+		}
+		borrowed = append(borrowed, result.state)
+	}
+	close(release)
+	for range borrowed {
+		<-released
+	}
+	if acquireErr != nil {
+		t.Fatalf("burst Acquire failed: %v", acquireErr)
+	}
+	if len(borrowed) != burstSize {
+		t.Fatalf("burst borrowed %d states, want %d simultaneously", len(borrowed), burstSize)
+	}
+	if got := created.Load(); got != burstSize {
+		t.Fatalf("cold+burst factory created %d states, want %d", got, burstSize)
+	}
+	if got := topLevelRuns.Load(); got != burstSize {
+		t.Fatalf("cold+burst top-level executions = %d, want one per %d VM", got, burstSize)
+	}
+
+	borrowedSet := make(map[*glua.LState]bool, len(borrowed))
+	for _, state := range borrowed {
+		borrowedSet[state] = true
+	}
+	pool.mu.Lock()
+	idle := append([]*glua.LState(nil), pool.idle...)
+	pool.mu.Unlock()
+	if len(idle) != maxIdleStates {
+		t.Fatalf("pool retained %d idle states after burst, want %d", len(idle), maxIdleStates)
+	}
+	idleSet := make(map[*glua.LState]bool, len(idle))
+	for _, state := range idle {
+		if !borrowedSet[state] {
+			t.Fatal("idle pool contains a state that was not borrowed in the forced burst")
+		}
+		if state.IsClosed() {
+			t.Fatal("idle pool retained a closed state")
+		}
+		idleSet[state] = true
+	}
+	open, closed := 0, 0
+	for _, state := range borrowed {
+		if state.IsClosed() {
+			closed++
+		} else {
+			open++
+		}
+	}
+	if open != maxIdleStates || closed != burstSize-maxIdleStates {
+		t.Fatalf("after burst release, open=%d closed=%d, want open=%d closed=%d", open, closed, maxIdleStates, burstSize-maxIdleStates)
+	}
+
+	for i := 0; i < maxIdleStates; i++ {
+		state, err := pool.Acquire(nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !idleSet[state] {
+			t.Fatalf("warm acquire %d did not draw from the retained idle set", i)
+		}
+		got, err := pass5CallRoute(state, 7, 41)
+		if err == nil && got != 72 {
+			err = fmt.Errorf("warm route returned %d, want 72", got)
+		}
+		pool.Release(state, err == nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := created.Load(); got != burstSize {
+		t.Fatalf("next %d warm acquisitions increased created states to %d", maxIdleStates, got)
+	}
+	if got := topLevelRuns.Load(); got != burstSize {
+		t.Fatalf("next %d warm acquisitions increased top-level runs to %d", maxIdleStates, got)
+	}
+}
+
+func TestValidationPass5PoolShortTimeoutCancelsLuaAndWorkContext(t *testing.T) {
+	program := pass5CompileFile(t, "timeout.lua", `function spin() while true do end end`)
+	var created atomic.Int64
+	factory := func(ctx context.Context) (*glua.LState, error) {
+		state, err := program.NewState(ctx, nil, nil)
+		if err == nil {
+			created.Add(1)
+		}
+		return state, err
+	}
+	pool, err := NewPool(context.Background(), 20*time.Millisecond, factory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(pool.Close)
+
+	var state *glua.LState
+	var workContext context.Context
+	started := time.Now()
+	err = pool.WithState(nil, 0, func(L *glua.LState) error {
+		state = L
+		workContext = L.Context()
+		L.Push(L.GetGlobal("spin"))
+		return L.PCall(0, 0, nil)
+	})
+	if err == nil || !strings.Contains(err.Error(), context.DeadlineExceeded.Error()) {
+		t.Fatalf("infinite Lua work error = %v, want a Lua error containing context deadline exceeded", err)
+	}
+	if elapsed := time.Since(started); elapsed < 10*time.Millisecond || elapsed > time.Second {
+		t.Fatalf("short timeout returned after %v, want prompt deadline cancellation", elapsed)
+	}
+	if !errors.Is(workContext.Err(), context.DeadlineExceeded) {
+		t.Fatalf("Lua work context error = %v, want context deadline exceeded", workContext.Err())
+	}
+	if state == nil || !state.IsClosed() {
+		t.Fatal("state that returned a Lua timeout error was not closed")
+	}
+	if got := created.Load(); got != 1 {
+		t.Fatalf("short-timeout case created %d states, want 1", got)
+	}
+}
+
+func BenchmarkValidationPass5PoolRoute(b *testing.B) {
+	for _, tc := range []struct {
+		name   string
+		source string
+	}{
+		{name: "CachedTopLevel16EntryLookup", source: pass5CachedLookupLua},
+		{name: "Rebuilt16EntryLookupPerCall", source: pass5RebuiltLookupLua},
+	} {
+		b.Run(tc.name, func(b *testing.B) {
+			program := pass5CompileFile(b, "route.lua", tc.source)
+			factory := program.NewStateFactory(time.Second, nil, nil)
+			pool, err := NewPool(context.Background(), time.Second, factory)
+			if err != nil {
+				b.Fatal(err)
+			}
+			defer pool.Close()
+
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				err := pool.WithState(nil, 0, func(L *glua.LState) error {
+					got, err := pass5CallRoute(L, 7, 41)
+					if err == nil && got != 72 {
+						return fmt.Errorf("route returned %d, want 72", got)
+					}
+					return err
+				})
+				if err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}

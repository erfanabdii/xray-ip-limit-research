+func TestConfigValidationRejectsUnsafeOrUnscopedValues(t *testing.T) {
+	tests := []struct {
+		name string
+		edit func(*Config)
+	}{
+		{"non-loopback dns", func(c *Config) { c.DNS = "0.0.0.0:5300" }},
+		{"IPv6 loopback spelling", func(c *Config) { c.Admin = "[::1]:8080" }},
+		{"non-loopback API", func(c *Config) { c.APIs[0] = "192.0.2.1:10085" }},
+		{"unscoped email", func(c *Config) { c.Emails[0] = "alice@example.com" }},
+		{"too many accounts", func(c *Config) {
+			for i := 0; i < maxAccounts; i++ {
+				c.Emails = append(c.Emails, fmt.Sprintf("fixture-extra-%d@example.invalid", i))
+			}
+		}},
+		{"too many nodes", func(c *Config) { c.APIs = append(c.APIs, "127.0.0.1:10086", "127.0.0.1:10087") }},
+		{"invalid nonce", func(c *Config) { c.Nonce = "not-hexadecimal!" }},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			cfg := fixtureConfig()
+			test.edit(&cfg)
+			if err := validateConfig(cfg); err == nil {
+				t.Fatal("validateConfig accepted invalid config")
+			}
+		})
+	}
+	if err := validateConfig(fixtureConfig()); err != nil {
+		t.Fatalf("valid test fixture rejected: %v", err)
+	}
+}

+func TestDecisionNameAcceptsOnlyScopedDocumentationIPs(t *testing.T) {
+	emails := []string{"fixture-a@example.invalid"}
+	for _, ip := range []string{"10", "11", "12"} {
+		name := "u0.p198-51-100-" + ip + ".0123456789abcdef.fixture.invalid."
+		gotEmail, gotIP, ok := parseDecisionName(name, "0123456789abcdef", emails)
+		if !ok || gotEmail != emails[0] || gotIP != "198.51.100."+ip {
+			t.Fatalf("parseDecisionName(%q) = %q, %q, %v", name, gotEmail, gotIP, ok)
+		}
+	}
+	for _, name := range []string{
+		"u1.p198-51-100-10.0123456789abcdef.fixture.invalid.",
+		"u0.p198-51-100-13.0123456789abcdef.fixture.invalid.",
+		"u0.p198-51-100-10.0123456789abcdee.fixture.invalid.",
+		"u00.p198-51-100-10.0123456789abcdef.fixture.invalid.",
+	} {
+		if _, _, ok := parseDecisionName(name, "0123456789abcdef", emails); ok {
+			t.Fatalf("parseDecisionName accepted malformed or unscoped name %q", name)
+		}
+	}
+}

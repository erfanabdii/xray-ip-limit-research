+func TestControlPartialUpdatesPreserveUnspecifiedValues(t *testing.T) {
+	c := testController(fixtureConfig())
+	delay := 55
+	if err := c.control(controlRequest{DelayMS: &delay}); err != nil {
+		t.Fatal(err)
+	}
+	paused := true
+	if err := c.control(controlRequest{StatsPaused: &paused}); err != nil {
+		t.Fatal(err)
+	}
+	capValue := 1
+	if err := c.control(controlRequest{Cap: &capValue}); err != nil {
+		t.Fatal(err)
+	}
+	status := c.status()
+	if status.DelayMS != 55 {
+		t.Fatalf("omitted delay_ms was not preserved: %+v", status)
+	}
+	c.mu.Lock()
+	gotCap, gotPaused := c.cap, c.statsPaused
+	c.mu.Unlock()
+	if gotCap != 1 || !gotPaused {
+		t.Fatalf("omitted control fields were not preserved: cap=%d paused=%v", gotCap, gotPaused)
+	}
+	paused = false
+	if err := c.control(controlRequest{StatsPaused: &paused}); err != nil {
+		t.Fatal(err)
+	}
+	if c.status().DelayMS != 55 {
+		t.Fatal("explicit stats_paused update unexpectedly reset delay_ms")
+	}
+}

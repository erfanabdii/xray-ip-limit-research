+++ b/cmd/validation5-controller/main.go
@@ -0,0 +1,646 @@
+package main
+
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/signal"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/miekg/dns"
+	statscommand "github.com/xtls/xray-core/app/stats/command"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+const (
+	rpcTimeout       = 150 * time.Millisecond
+	maxDNSInFlight   = 64
+	maxConfigBytes   = 64 * 1024
+	maxControlBytes  = 4 * 1024
+	maxAccounts      = 16
+	maxNodes         = 2
+	permitAddress    = "127.0.0.1"
+	denyAddress      = "127.0.0.2"
+	adminNonceHeader = "X-Fixture-Nonce"
+)
+
+var fixtureEmailRE = regexp.MustCompile(`^fixture-[a-z0-9][a-z0-9-]{0,62}@example\.invalid$`)
+
+type Config struct {
+	DNS    string   `json:"dns"`
+	Admin  string   `json:"admin"`
+	APIs   []string `json:"apis"`
+	Nonce  string   `json:"nonce"`
+	Emails []string `json:"emails"`
+	Cap    int      `json:"cap"`
+	PollMS int      `json:"poll_ms"`
+}
+
+type grant struct {
+	email string
+	ip    string
+}
+
+type apiEndpoint struct {
+	addr   string
+	client statscommand.StatsServiceClient
+	conn   *grpc.ClientConn
+}
+
+type Controller struct {
+	mu          sync.Mutex
+	apis        []apiEndpoint
+	emailSet    map[string]struct{}
+	owners      map[grant]struct{}
+	cap         int
+	statsPaused bool
+	healthy     bool
+	recovering  bool
+	pollOK      uint64
+	pollErrors  uint64
+	grants      uint64
+	denied      uint64
+	releases    uint64
+	delayMS     atomic.Int32
+}
+
+type Status struct {
+	PollOK     uint64                     `json:"poll_ok"`
+	PollErrors uint64                     `json:"errors"`
+	Grants     uint64                     `json:"grants"`
+	Denied     uint64                     `json:"denied"`
+	Releases   uint64                     `json:"releases"`
+	Recovering bool                       `json:"recovering"`
+	Healthy    bool                       `json:"healthy"`
+	Owners     map[string]map[string]bool `json:"owners"`
+	DelayMS    int32                      `json:"delay_ms"`
+}
+
+func main() {
+	flags := flag.NewFlagSet(os.Args[0], flag.ExitOnError)
+	configPath := flags.String("config", "", "path to controller JSON configuration")
+	_ = flags.Parse(os.Args[1:])
+	if *configPath == "" || flags.NArg() != 0 {
+		fmt.Fprintln(os.Stderr, "usage: validation5-controller -config <JSON path>")
+		os.Exit(2)
+	}
+
+	configBytes, err := readConfig(*configPath)
+	if err != nil {
+		fatal(err)
+	}
+	cfg, err := decodeConfig(configBytes)
+	if err != nil {
+		fatal(err)
+	}
+
+	controller, conns, err := newLiveController(cfg)
+	if err != nil {
+		fatal(err)
+	}
+	defer func() {
+		for _, conn := range conns {
+			_ = conn.Close()
+		}
+	}()
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	if err := serve(ctx, cfg, controller); err != nil && !errors.Is(err, context.Canceled) {
+		fatal(err)
+	}
+}
+
+func fatal(err error) {
+	fmt.Fprintln(os.Stderr, err)
+	os.Exit(1)
+}
+
+func readConfig(path string) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("open config: %w", err)
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, maxConfigBytes+1))
+	if err != nil {
+		return nil, fmt.Errorf("read config: %w", err)
+	}
+	if len(data) > maxConfigBytes {
+		return nil, errors.New("config exceeds 64 KiB")
+	}
+	return data, nil
+}
+
+func decodeConfig(data []byte) (Config, error) {
+	var cfg Config
+	dec := json.NewDecoder(strings.NewReader(string(data)))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&cfg); err != nil {
+		return Config{}, fmt.Errorf("decode config: %w", err)
+	}
+	if err := ensureEOF(dec); err != nil {
+		return Config{}, err
+	}
+	if err := validateConfig(cfg); err != nil {
+		return Config{}, err
+	}
+	return cfg, nil
+}
+
+func ensureEOF(dec *json.Decoder) error {
+	var extra any
+	if err := dec.Decode(&extra); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return errors.New("config must contain one JSON value")
+		}
+		return fmt.Errorf("trailing config data: %w", err)
+	}
+	return nil
+}
+
+func validateConfig(cfg Config) error {
+	if _, err := validateLoopbackAddress("dns", cfg.DNS); err != nil {
+		return err
+	}
+	if _, err := validateLoopbackAddress("admin", cfg.Admin); err != nil {
+		return err
+	}
+	if len(cfg.APIs) < 1 || len(cfg.APIs) > maxNodes {
+		return fmt.Errorf("apis must contain 1 through %d loopback addresses", maxNodes)
+	}
+	seenAPIs := make(map[string]struct{}, len(cfg.APIs))
+	for i, addr := range cfg.APIs {
+		canonical, err := validateLoopbackAddress(fmt.Sprintf("apis[%d]", i), addr)
+		if err != nil {
+			return err
+		}
+		if _, exists := seenAPIs[canonical]; exists {
+			return fmt.Errorf("apis[%d] duplicates an API endpoint", i)
+		}
+		seenAPIs[canonical] = struct{}{}
+	}
+	if len(cfg.Emails) < 1 || len(cfg.Emails) > maxAccounts {
+		return fmt.Errorf("emails must contain 1 through %d fixture accounts", maxAccounts)
+	}
+	seenEmails := make(map[string]struct{}, len(cfg.Emails))
+	for i, email := range cfg.Emails {
+		if !fixtureEmailRE.MatchString(email) {
+			return fmt.Errorf("emails[%d] must match fixture-...@example.invalid", i)
+		}
+		if _, exists := seenEmails[email]; exists {
+			return fmt.Errorf("emails[%d] duplicates a fixture account", i)
+		}
+		seenEmails[email] = struct{}{}
+	}
+	if len(cfg.Nonce) < 16 || len(cfg.Nonce) > 62 || len(cfg.Nonce)%2 != 0 || strings.ToLower(cfg.Nonce) != cfg.Nonce {
+		return errors.New("nonce must be 16 through 62 lowercase hexadecimal characters with even length")
+	}
+	if _, err := hex.DecodeString(cfg.Nonce); err != nil {
+		return errors.New("nonce must be hexadecimal")
+	}
+	if cfg.Cap < 1 || cfg.Cap > 3 {
+		return errors.New("cap must be from 1 through 3")
+	}
+	if cfg.PollMS < 10 || cfg.PollMS > 60000 {
+		return errors.New("poll_ms must be from 10 through 60000")
+	}
+	return nil
+}
+
+func validateLoopbackAddress(field, addr string) (string, error) {
+	host, portText, err := net.SplitHostPort(addr)
+	if err != nil {
+		return "", fmt.Errorf("%s must be an explicit 127.0.0.1:port address: %w", field, err)
+	}
+	if host != "127.0.0.1" {
+		return "", fmt.Errorf("%s host must be exactly 127.0.0.1", field)
+	}
+	port, err := strconv.Atoi(portText)
+	if err != nil || port < 1 || port > 65535 {
+		return "", fmt.Errorf("%s port must be an integer from 1 through 65535", field)
+	}
+	return net.JoinHostPort(host, strconv.Itoa(port)), nil
+}
+
+func newLiveController(cfg Config) (*Controller, []*grpc.ClientConn, error) {
+	clients := make([]statscommand.StatsServiceClient, 0, len(cfg.APIs))
+	conns := make([]*grpc.ClientConn, 0, len(cfg.APIs))
+	for _, addr := range cfg.APIs {
+		conn, err := grpc.NewClient(addr, grpc.WithTransportCredentials(insecure.NewCredentials()))
+		if err != nil {
+			for _, opened := range conns {
+				_ = opened.Close()
+			}
+			return nil, nil, fmt.Errorf("create StatsService client for %s: %w", addr, err)
+		}
+		conns = append(conns, conn)
+		clients = append(clients, statscommand.NewStatsServiceClient(conn))
+	}
+	return newController(cfg, clients), conns, nil
+}
+
+func newController(cfg Config, clients []statscommand.StatsServiceClient) *Controller {
+	emails := make(map[string]struct{}, len(cfg.Emails))
+	for _, email := range cfg.Emails {
+		emails[email] = struct{}{}
+	}
+	apis := make([]apiEndpoint, len(clients))
+	for i, client := range clients {
+		addr := ""
+		if i < len(cfg.APIs) {
+			addr = cfg.APIs[i]
+		}
+		apis[i] = apiEndpoint{addr: addr, client: client}
+	}
+	c := &Controller{
+		apis:       apis,
+		emailSet:   emails,
+		owners:     make(map[grant]struct{}),
+		cap:        cfg.Cap,
+		recovering: true,
+	}
+	c.delayMS.Store(0)
+	return c
+}
+
+func (c *Controller) admit(email, ip string) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.healthy || c.recovering {
+		c.denied++
+		return false
+	}
+	key := grant{email: email, ip: ip}
+	if _, exists := c.owners[key]; exists {
+		return true
+	}
+	uniqueIPs := 0
+	for owner := range c.owners {
+		if owner.email == email {
+			uniqueIPs++
+		}
+	}
+	if uniqueIPs >= c.cap {
+		c.denied++
+		return false
+	}
+	c.owners[key] = struct{}{}
+	c.grants++
+	return true
+}
+
+func (c *Controller) deny() {
+	c.mu.Lock()
+	c.denied++
+	c.mu.Unlock()
+}
+
+func (c *Controller) pollOnce(ctx context.Context) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if ctx.Err() != nil {
+		return
+	}
+	if c.statsPaused {
+		c.healthy = false
+		c.pollErrors++
+		return
+	}
+	active := make(map[grant]struct{})
+	activeAccount := false
+	for _, api := range c.apis {
+		if api.client == nil {
+			c.healthy = false
+			c.pollErrors++
+			return
+		}
+		rpcCtx, cancel := context.WithTimeout(ctx, rpcTimeout)
+		response, err := api.client.GetUsersStats(rpcCtx, &statscommand.GetUsersStatsRequest{IncludeTraffic: false, Reset_: false})
+		cancel()
+		if err != nil || response == nil {
+			c.healthy = false
+			c.pollErrors++
+			return
+		}
+		for _, user := range response.GetUsers() {
+			if user == nil {
+				continue
+			}
+			email := user.GetEmail()
+			if _, scoped := c.emailSet[email]; !scoped {
+				continue
+			}
+			for _, entry := range user.GetIps() {
+				if entry == nil || entry.GetIp() == "" {
+					continue
+				}
+				activeAccount = true
+				active[grant{email: email, ip: entry.GetIp()}] = struct{}{}
+			}
+		}
+	}
+	c.pollOK++
+	c.healthy = true
+	if c.recovering {
+		if !activeAccount {
+			c.recovering = false
+		}
+		return
+	}
+	for owner := range c.owners {
+		if _, present := active[owner]; !present {
+			delete(c.owners, owner)
+			c.releases++
+		}
+	}
+}
+
+func (c *Controller) pollLoop(ctx context.Context, pollMS int) {
+	c.pollOnce(ctx)
+	ticker := time.NewTicker(time.Duration(pollMS) * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			c.pollOnce(ctx)
+		}
+	}
+}
+
+func (c *Controller) status() Status {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	owners := make(map[string]map[string]bool)
+	for owner := range c.owners {
+		if owners[owner.email] == nil {
+			owners[owner.email] = make(map[string]bool)
+		}
+		owners[owner.email][owner.ip] = true
+	}
+	return Status{
+		PollOK: c.pollOK, PollErrors: c.pollErrors,
+		Grants: c.grants, Denied: c.denied, Releases: c.releases,
+		Recovering: c.recovering, Healthy: c.healthy,
+		Owners: owners, DelayMS: c.delayMS.Load(),
+	}
+}
+
+func (c *Controller) control(req controlRequest) error {
+	if req.DelayMS != nil && (*req.DelayMS < 0 || *req.DelayMS > 1000) {
+		return errors.New("delay_ms must be from 0 through 1000")
+	}
+	if req.Cap != nil && (*req.Cap < 1 || *req.Cap > 3) {
+		return errors.New("cap must be from 1 through 3")
+	}
+	if req.DelayMS == nil && req.StatsPaused == nil && req.Cap == nil {
+		return errors.New("control must set delay_ms, stats_paused, or cap")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if req.Cap != nil {
+		c.cap = *req.Cap
+	}
+	if req.StatsPaused != nil {
+		c.statsPaused = *req.StatsPaused
+		if c.statsPaused {
+			c.healthy = false
+		}
+	}
+	if req.DelayMS != nil {
+		c.delayMS.Store(int32(*req.DelayMS))
+	}
+	return nil
+}
+
+func serve(ctx context.Context, cfg Config, controller *Controller) error {
+	dnsConn, err := net.ListenPacket("udp", cfg.DNS)
+	if err != nil {
+		return fmt.Errorf("listen DNS on %s: %w", cfg.DNS, err)
+	}
+	adminListener, err := net.Listen("tcp", cfg.Admin)
+	if err != nil {
+		_ = dnsConn.Close()
+		return fmt.Errorf("listen admin on %s: %w", cfg.Admin, err)
+	}
+
+	stopDNS := make(chan struct{})
+	dnsServer := &dns.Server{PacketConn: dnsConn, Handler: dnsHandler{controller: controller, emails: cfg.Emails, nonce: cfg.Nonce, stop: stopDNS, semaphore: make(chan struct{}, maxDNSInFlight)}, ReadTimeout: 3 * time.Second, WriteTimeout: 3 * time.Second}
+	httpServer := &http.Server{
+		Handler:           adminHandler{controller: controller, nonce: cfg.Nonce},
+		ReadHeaderTimeout: 2 * time.Second,
+		ReadTimeout:       3 * time.Second,
+		WriteTimeout:      3 * time.Second,
+		IdleTimeout:       15 * time.Second,
+	}
+
+	runCtx, cancelRun := context.WithCancel(ctx)
+	defer cancelRun()
+	var servers sync.WaitGroup
+	serverErr := make(chan error, 2)
+	servers.Add(2)
+	go func() {
+		defer servers.Done()
+		serverErr <- dnsServer.ActivateAndServe()
+	}()
+	go func() {
+		defer servers.Done()
+		serverErr <- httpServer.Serve(adminListener)
+	}()
+	var poller sync.WaitGroup
+	poller.Add(1)
+	go func() {
+		defer poller.Done()
+		controller.pollLoop(runCtx, cfg.PollMS)
+	}()
+
+	var runErr error
+	select {
+	case <-ctx.Done():
+	case runErr = <-serverErr:
+		if errors.Is(runErr, net.ErrClosed) || errors.Is(runErr, http.ErrServerClosed) {
+			runErr = nil
+		}
+	}
+	cancelRun()
+	close(stopDNS)
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if err := httpServer.Shutdown(shutdownCtx); err != nil && runErr == nil {
+		runErr = fmt.Errorf("shutdown admin server: %w", err)
+	}
+	if err := dnsServer.Shutdown(); err != nil && runErr == nil {
+		runErr = fmt.Errorf("shutdown DNS server: %w", err)
+	}
+	_ = adminListener.Close()
+	_ = dnsConn.Close()
+	poller.Wait()
+	servers.Wait()
+	return runErr
+}
+
+type dnsHandler struct {
+	controller *Controller
+	emails     []string
+	nonce      string
+	stop       <-chan struct{}
+	semaphore  chan struct{}
+}
+
+func (h dnsHandler) ServeDNS(w dns.ResponseWriter, req *dns.Msg) {
+	if req == nil || len(req.Question) != 1 || req.Question[0].Qtype != dns.TypeA || req.Question[0].Qclass != dns.ClassINET {
+		writeDNSReply(w, req, dns.RcodeRefused, "")
+		return
+	}
+	remote, _, err := net.SplitHostPort(w.RemoteAddr().String())
+	if err != nil || net.ParseIP(remote) == nil || !net.ParseIP(remote).IsLoopback() {
+		writeDNSReply(w, req, dns.RcodeRefused, "")
+		return
+	}
+	email, ip, ok := parseDecisionName(req.Question[0].Name, h.nonce, h.emails)
+	if !ok {
+		writeDNSReply(w, req, dns.RcodeRefused, "")
+		return
+	}
+	select {
+	case h.semaphore <- struct{}{}:
+		defer func() { <-h.semaphore }()
+	default:
+		h.controller.deny()
+		writeDNSReply(w, req, dns.RcodeSuccess, denyAddress)
+		return
+	}
+	if delay := time.Duration(h.controller.delayMS.Load()) * time.Millisecond; delay > 0 {
+		timer := time.NewTimer(delay)
+		defer timer.Stop()
+		select {
+		case <-timer.C:
+		case <-h.stop:
+			writeDNSReply(w, req, dns.RcodeRefused, "")
+			return
+		}
+	}
+	answer := denyAddress
+	if h.controller.admit(email, ip) {
+		answer = permitAddress
+	}
+	writeDNSReply(w, req, dns.RcodeSuccess, answer)
+}
+
+func parseDecisionName(qname, nonce string, emails []string) (string, string, bool) {
+	if qname == "" || !strings.HasSuffix(qname, ".") || qname != strings.ToLower(qname) {
+		return "", "", false
+	}
+	canonical := dns.Fqdn(qname)
+	labels := strings.Split(strings.TrimSuffix(canonical, "."), ".")
+	if len(labels) != 5 || labels[2] != nonce || labels[3] != "fixture" || labels[4] != "invalid" {
+		return "", "", false
+	}
+	if !strings.HasPrefix(labels[0], "u") || len(labels[0]) == 1 {
+		return "", "", false
+	}
+	index, err := strconv.Atoi(strings.TrimPrefix(labels[0], "u"))
+	if err != nil || index < 0 || index >= len(emails) || strconv.Itoa(index) != strings.TrimPrefix(labels[0], "u") {
+		return "", "", false
+	}
+	var ip string
+	switch labels[1] {
+	case "p198-51-100-10":
+		ip = "198.51.100.10"
+	case "p198-51-100-11":
+		ip = "198.51.100.11"
+	case "p198-51-100-12":
+		ip = "198.51.100.12"
+	default:
+		return "", "", false
+	}
+	return emails[index], ip, true
+}
+
+func writeDNSReply(w dns.ResponseWriter, req *dns.Msg, rcode int, answerIP string) {
+	if req == nil {
+		return
+	}
+	msg := new(dns.Msg)
+	msg.SetReply(req)
+	msg.Authoritative = true
+	msg.Rcode = rcode
+	if rcode == dns.RcodeSuccess && answerIP != "" {
+		msg.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: req.Question[0].Name, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 0}, A: net.ParseIP(answerIP).To4()}}
+	}
+	_ = w.WriteMsg(msg)
+}
+
+type controlRequest struct {
+	DelayMS     *int  `json:"delay_ms,omitempty"`
+	StatsPaused *bool `json:"stats_paused,omitempty"`
+	Cap         *int  `json:"cap,omitempty"`
+}
+
+type adminHandler struct {
+	controller *Controller
+	nonce      string
+}
+
+func (h adminHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.Header.Get(adminNonceHeader) != h.nonce {
+		http.Error(w, "unauthorized", http.StatusForbidden)
+		return
+	}
+	switch {
+	case r.URL.Path == "/status" && r.Method == http.MethodGet:
+		writeJSON(w, http.StatusOK, h.controller.status())
+	case r.URL.Path == "/control" && r.Method == http.MethodPost:
+		req, err := decodeControl(w, r)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if err := h.controller.control(req); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		writeJSON(w, http.StatusOK, h.controller.status())
+	case r.URL.Path == "/status" || r.URL.Path == "/control":
+		w.Header().Set("Allow", map[string]string{"/status": http.MethodGet, "/control": http.MethodPost}[r.URL.Path])
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func decodeControl(w http.ResponseWriter, r *http.Request) (controlRequest, error) {
+	r.Body = http.MaxBytesReader(w, r.Body, maxControlBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	var req controlRequest
+	if err := dec.Decode(&req); err != nil {
+		return controlRequest{}, fmt.Errorf("invalid control JSON: %w", err)
+	}
+	if err := ensureEOF(dec); err != nil {
+		return controlRequest{}, err
+	}
+	return req, nil
+}
+
+func writeJSON(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(value)
+}

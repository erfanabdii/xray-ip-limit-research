+func TestAdmissionCapacityIsAtomicAcrossConcurrentRequests(t *testing.T) {
+	c := testController(fixtureConfig())
+	ips := []string{"198.51.100.10", "198.51.100.11", "198.51.100.12"}
+	var wg sync.WaitGroup
+	for _, ip := range ips {
+		for i := 0; i < 80; i++ {
+			wg.Add(1)
+			go func(ip string) {
+				defer wg.Done()
+				c.admit("fixture-a@example.invalid", ip)
+			}(ip)
+		}
